{
  "name": "cooktwo-v3",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node ./node_modules/astro/bin/astro.mjs dev",
    "build": "node scripts/extract-content.js && node ./node_modules/astro/bin/astro.mjs build && node scripts/image-sitemap.mjs && node scripts/build-info.mjs",
    "deploy": "npm run build && node ./node_modules/wrangler/bin/wrangler.js pages deploy dist --project-name=couples-food-system-v3 --branch=main && node scripts/verify-live.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "preview": "node ./node_modules/astro/bin/astro.mjs preview",
    "astro": "node ./node_modules/astro/bin/astro.mjs",
    "index:pinecone": "node scripts/extract-content.js && node scripts/index-to-pinecone.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.0",
    "@astrojs/sitemap": "^3.7.3",
    "@langchain/openai": "^0.3.16",
    "@langchain/textsplitters": "^0.1.0",
    "@pinecone-database/pinecone": "^4.0.0",
    "@tailwindcss/typography": "^0.5.15",
    "astro": "^6.4.6",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "wrangler": "^4.129.1"
  }
}
