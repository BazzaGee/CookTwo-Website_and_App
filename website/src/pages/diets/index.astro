---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Faq from '../../components/prose/Faq.astro';
import StudyCard from '../../components/diets/StudyCard.astro';
import SharedPrinciples from '../../components/diets/SharedPrinciples.astro';
import DietSpectrum from '../../components/diets/DietSpectrum.astro';
import DietCard from '../../components/diets/DietCard.astro';
import SourceList from '../../components/diets/SourceList.astro';
import EarlyAccessButton from '../../components/forms/EarlyAccessButton.astro';
import Callout from '../../components/prose/Callout.astro';
import { DIETS } from '../../data/diets';
import { DIET_CATEGORY_ORDER, DIET_GUIDES } from '../../data/diet-guides';

const title = 'Any Sensible Diet Can Work. Here Is What the Evidence Says | CookTwo';
const description = 'Keto, low-carb, high-carb, low-fat, vegan, paleo — the research keeps pointing at the same thing: food quality, nutrient adequacy and adherence decide whether a diet is healthy.';
const pubDate = new Date('2026-11-02');

const dietsById = new Map(DIETS.map((d) => [d.dietKey, d]));
const published = await getCollection('diets', ({ data }) => data.draft !== true);
const publishedKeys = new Set(published.map((entry) => entry.id));
// published paths use entry.id as slug, guide rows are keyed by dietKey
const slugByKey = new Map(published.map((entry) => [`/${entry.id}`, entry.id]));
// Build ordered guide rows sorted by hub categories then label
const orderedGuides = DIET_CATEGORY_ORDER.flatMap((cat) =>
  DIET_GUIDES
    .filter((g) => g.category === cat.id && dietsById.has(g.dietKey))
    .map((g) => ({ row: g, diet: dietsById.get(g.dietKey) as (typeof DIETS)[number] }))
);

const faqs = [
  { q: 'Can any diet be healthy?', a: 'Any sensible diet can be healthy when it is built from whole foods, meets your protein, fibre and micronutrient needs, and you can sustain it. Randomized trials directly comparing well-constructed low-carb and low-fat diets found near-identical weight loss, and landmark cohorts show the healthiest carbohydrate window sits in the moderate middle. What reliably harms: ultra-processed food, nutrient gaps, and extremes nobody can maintain. Extreme elimination patterns — carnivore, 80/10/10 — have weak evidence and belong in a different category entirely.' },
  { q: 'What matters more: the diet or the food quality?', a: 'Food quality, and it is not close. In one of the most tightly controlled studies on this question, the meals were matched for calories, macros, sugar, fibre and sodium. People still ate about 508 more calories a day on the ultra-processed diet, gained weight on it, and lost weight on the whole-food diet. Processing level beats macro ratio as the health variable.' },
  { q: 'Which diet has the strongest evidence?', a: 'The Mediterranean diet, with multiple large randomized trials including a ~30% reduction in major cardiovascular events in the PREDIMED study, followed by DASH, which deliberately lowered blood pressure in landmark trials. Several others — keto, low FODMAP, plant-based — have grade-A or solid evidence within specific uses. No diet is best at everything, and "strongest evidence" depends what outcome you count.' },
  { q: 'Why do nutrition studies seem to contradict each other?', a: 'Because they measure different things at different strengths. Randomized controlled trials test cause-and-effect for months. Cohort studies follow hundreds of thousands of people for years but only show association. Both are honest; both have blind spots. This hub grades every claim so you can see which kind of evidence sits behind it.' },
  { q: 'Is a high-carb diet unhealthy?', a: 'Whole-food carbohydrate is not. Two of the longest-lived populations in documented history — Okinawa at roughly 85% carbohydrate and Sardinia at roughly 50% — sat at opposite ends of the fat scale and both lived long. What harms is refined, starch-milled, sugar-laden carbohydrate. The 2018 Lancet Public Health analysis found mortality lowest at 50–55% carbohydrate, rising at the extremes.' },
  { q: 'What should I do if my partner and I follow different diets?', a: 'Pick whichever evidence-backed pattern fits your health goal — or keep one flexible base and adapt each plate. CookTwo is built for exactly this: one shared recipe, personalised portions and diet adaptations per plate from the same handful of ingredients.' }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }))
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://cooktwo.com/' },
    { '@type': 'ListItem', position: 2, name: 'Diet evidence', item: 'https://cooktwo.com/diets/' }
  ]
};

const itemSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'CookTwo diet evidence guides',
  itemListElement: DIET_CATEGORY_ORDER.flatMap((cat) =>
    DIET_GUIDES
      .filter((g) => g.category === cat.id && dietsById.has(g.dietKey))
      .map((g) => ({
        '@type': 'ListItem',
        name: (dietsById.get(g.dietKey) as (typeof DIETS)[number]).displayLabel,
        url: `https://cooktwo.com${g.href}/`
      }))
  )
};

const tocItems = [
  ['the-short-answer', 'The short answer'],
  ['story', 'The view from the gym floor'],
  ['evidence', 'What the evidence shows'],
  ['quality', 'Food quality beats the label'],
  ['map', 'Long-lived populations'],
  ['fundamentals', 'What every healthy diet shares'],
  ['spectrum', 'The diet spectrum'],
  ['catalog', 'All 25 diet guides'],
  ['judge', 'How to judge any diet'],
  ['limits', 'When a diet is not okay'],
  ['method', 'How we research'],
  ['faq', 'Common questions']
] as const;
---

<BaseLayout title={title} description={description} ogImage="/images/diets/og/diet-hub.webp" canonicalURL="/diets" isArticle={true} articlePublishedDate={pubDate.toISOString()} articleAuthor="Barry (personal trainer)" articleTags={['diets', 'nutrition evidence', 'food quality']}>
  {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>}
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>}
  {itemSchema && <script type="application/ld+json" set:html={JSON.stringify(itemSchema)}></script>}

  <nav aria-label="On this page" class="sticky top-20 z-30 bg-cream/85 backdrop-blur-md border-b border-border">
    <div class="container-custom max-w-6xl">
      <ul class="flex items-center gap-1 overflow-x-auto py-3 text-sm font-medium no-scrollbar">
        <li class="text-text-secondary/70 whitespace-nowrap pr-2 hidden sm:block">On this page:</li>
        {tocItems.map(([id, label]) => (
          <li><a href={`#${id}`} class="whitespace-nowrap px-3 py-1.5 rounded-lg text-text-secondary hover:text-sage-dark hover:bg-sage/5 transition-colors">{label}</a></li>
        ))}
      </ul>
    </div>
  </nav>

  <section class="container-custom max-w-6xl pt-12 pb-6 md:pt-20">
    <span class="badge-signature mb-6 inline-block">Diet evidence</span>
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-text-primary leading-tight mb-6">Any sensible diet can work.<br/><span class="text-sage">Here is what the evidence says.</span></h1>
    <p class="text-xl md:text-2xl text-text-secondary leading-relaxed max-w-3xl mb-8">
      Keto, low-carb, high-carb, low-fat, vegan, paleo. Each one has a loud fan club, and most gyms spend their days refereeing the arguments. The research, though, won't pick a side. Across landmark randomized trials, reviews covering around ten million people, and traditional eating patterns from five continents, the thing that separates healthy diets from unhealthy ones isn't the name on the plan. It's three things: the quality of the food, whether the nutrients actually arrive, and whether a person can keep going. I've watched that play out with every client I've trained, and I've watched the diet wars ignore it just as consistently.
    </p>
    <div class="flex flex-wrap items-center gap-3 text-sm text-text-secondary mb-4">
      <span>By <strong class="font-semibold text-text-primary">Barry</strong>, personal trainer, written with the CookTwo research desk</span>
      <span aria-hidden="true">·</span>
      <time datetime={pubDate.toISOString()}>November 2, 2026</time>
      <span aria-hidden="true">·</span>
      <span>19 min read</span>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-8">
      {[
        { v: '25', l: 'diet evidence guides', s: 'every pattern in the CookTwo app' },
        { v: '6', l: 'landmark sources below', s: 'five studies and one population map' },
        { v: '5', l: 'fundamentals that decide', s: 'the same in every food culture' },
        { v: '1', l: 'sentence of relief', s: 'you do not have to be perfect' }
      ].map((s) => (
        <div class="bg-white rounded-2xl border border-border p-5 shadow-sm text-center">
          <p class="text-3xl md:text-4xl font-bold text-sage tracking-tight">{s.v}</p>
          <p class="text-sm font-semibold text-text-primary mt-1.5">{s.l}</p>
          <p class="text-xs text-text-secondary mt-0.5">{s.s}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="the-short-answer" class="container-custom max-w-4xl scroll-mt-36 py-10 md:py-14">
    <div class="rounded-2xl border-2 border-sage/60 bg-sage/5 p-6 sm:p-10">
      <p class="text-xs font-semibold uppercase tracking-widest text-sage-dark mb-3">The short answer</p>
      <p class="text-2xl md:text-3xl font-bold leading-snug text-text-primary">Almost any sensible diet can be healthy.</p>
      <ul class="mt-6 space-y-4 text-lg leading-relaxed text-text-primary">
        <li class="flex gap-3"><span class="mt-3 h-2 w-2 flex-shrink-0 rounded-full bg-sage-dark" aria-hidden="true"></span><span><strong class="font-semibold">Low-carb and low-fat tie.</strong> Trials that built a good low-carb diet and a good low-fat diet found the same weight loss at one year.</span></li>
        <li class="flex gap-3"><span class="mt-3 h-2 w-2 flex-shrink-0 rounded-full bg-sage-dark" aria-hidden="true"></span><span><strong class="font-semibold">The middle wins.</strong> One of the largest cohorts ever assembled found the safest carbohydrate window in the moderate middle, not at an extreme.</span></li>
        <li class="flex gap-3"><span class="mt-3 h-2 w-2 flex-shrink-0 rounded-full bg-sage-dark" aria-hidden="true"></span><span><strong class="font-semibold">Processing decides.</strong> In one of the most tightly controlled feeding studies ever run, people gained weight on a calorie-matched ultra-processed diet and lost weight on whole food.</span></li>
        <li class="flex gap-3"><span class="mt-3 h-2 w-2 flex-shrink-0 rounded-full bg-sage-dark" aria-hidden="true"></span><span><strong class="font-semibold">Real food, every time.</strong> Every long-lived population studied so far, at every macro ratio, ate real food, moved a lot and stayed at it for a lifetime.</span></li>
      </ul>
      <p class="mt-6 text-text-primary leading-relaxed">That is the thesis of this hub. Each of the <a href="#catalog" class="text-sage-dark font-medium hover:text-sage underline decoration-sage/40 underline-offset-2">25 diet guides</a> below applies it honestly, including where the science is thin and where an honest writer has to say no.</p>
    </div>
  </section>

  <section id="story" class="container-custom max-w-4xl scroll-mt-36 py-10 md:py-14">
    <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-6">The view from the gym floor</h2>
    <div class="mx-auto max-w-[68ch] space-y-5 text-lg leading-relaxed text-text-primary">
      <p>I have one quiet advantage over most people who publish diet opinions: I keep score after they stop talking. Personal training is where nutrition arguments meet real life. A new client turns up carrying whatever diet they were most recently convinced by: a keto notebook, a screenshot of a fasting window, a shelf of branded shakes. A few weeks later, we both find out what that diet is actually made of, and whether a real person can live inside it.</p>
      <p>Early on, I made the classic mistake. I had one plan and tried to fit every client into it. Some agreed and did well. Others kept their own eating (vegan, keto, plain "normal food") and did just as well, as long as the plan ran on real food and they actually liked living in it. <strong class="font-semibold">No diet name ever predicted who would thrive.</strong> The fit between the plan and the person did, and so did the quality of how the plan was built.</p>
      <p>That taught me to ask a better question. Not "which diet is best?" but "what does this diet share with every other one that worked?" So I sat down with the research, expecting it to name a winner. It didn't. Five landmark studies and one population map, all covered below, point the same way: <strong class="font-semibold">the name of the plan is close to irrelevant. The construction is everything.</strong></p>
      <p>What follows is that evidence, the shared foundation every healthy diet stands on, an evidence grade for every pattern CookTwo supports, and the questions I now run every client through before they commit to a plan.</p>
    </div>
    <figure class="not-prose my-10">
      <img src="/images/diets/article/gym-floor.webp" alt="A bright training studio with a kettlebell, a resistance band and a glass meal-prep container of chicken, greens and sweet potato on the wooden floor." width="1600" height="1067" loading="lazy" decoding="async" class="w-full h-auto rounded-2xl border border-border shadow-sm" />
      <figcaption class="mt-3 text-sm leading-relaxed text-text-secondary">Illustration: a training studio, with a home-prepared meal on the floor beside the kettlebell.</figcaption>
    </figure>
  </section>

  <section id="evidence" class="container-custom max-w-4xl scroll-mt-36 py-10 md:py-16">
    <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-4">What the evidence actually shows</h2>
    <div class="mx-auto max-w-[68ch] space-y-5 text-lg leading-relaxed text-text-primary">
      <p>I went looking for a winner: the one study that would crown the right diet and end the argument. Five landmark studies and one population map later, I had finished with the argument instead. Not one of them cares about macro ratios the way the internet does. Together they explain why the diet wars never resolve, and why the people quietly getting results are not the ones arguing.</p>
      <p>Each card below lists the study design, who was studied, how long it ran and what it found. <strong class="font-semibold">The bold figures are the ones worth remembering.</strong></p>
    </div>

    <div class="mx-auto mt-8 max-w-3xl">
      <StudyCard
        name="DIETFITS: a healthy low-carb diet vs a healthy low-fat diet (JAMA, 2018)"
        design="Randomized controlled trial"
        participants="609 adults"
        duration="12 months"
        finding="Weight loss came out **nearly identical, at about 5–6 kg in both groups**. Each person's baseline insulin sensitivity did **not** predict which diet worked better for them. Both diets were built from whole food, and both cut sugar and refined flour."
        url="https://pubmed.ncbi.nlm.nih.gov/29490351/"
      />

      <aside class="not-prose my-8 rounded-2xl border-l-4 border-terracotta/60 bg-terracotta/5 p-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-terracotta-dark mb-2">From the gym floor</p>
        <p class="text-text-primary leading-relaxed">I have watched a devoted low-carber and a devoted high-carber land on nearly the same results in the same training block. Both plans ran on real food, both hit their protein, and both were followed by people who had genuinely chosen them. Neither one needed to win an argument with the other. That is DIETFITS with faces on it.</p>
      </aside>

      <StudyCard
        name="Hall et al.: the NIH inpatient ultra-processed diet trial (Cell Metabolism, 2019)"
        design="Randomized crossover, metabolic ward"
        participants="20 adults"
        duration="2 weeks per arm"
        finding="Calories, macros, sugar, fibre and sodium were all matched, so the two diets had nearly identical nutrition labels. Yet people **ate 508 kcal a day more** on the ultra-processed version and **gained weight**, while they **lost weight** on the whole-food version. Processing level, not the macro maths, overrode satiety."
        url="https://pubmed.ncbi.nlm.nih.gov/31195085/"
      />

      <StudyCard
        name="PURE: 135,000 people across 18 countries (The Lancet, 2017)"
        design="Prospective cohort"
        participants="135,335 adults, 5 continents"
        duration="Median 7.4 years"
        finding="Carbohydrate above **60% of energy**, mostly from refined staples, tracked with **higher total mortality**. Total fat, including saturated fat, tracked with **lower** mortality. Neither is a hero or a villain. The extremes and the refining are the problem."
        url="https://doi.org/10.1016/S0140-6736(17)32252-3"
      />

      <StudyCard
        name="Seidelmann et al.: the carbohydrate U-curve (Lancet Public Health, 2018)"
        design="Cohort plus meta-analysis"
        participants="432,179 adults"
        duration="~25 years"
        finding="Mortality was lowest at **50–55% carbohydrate** and rose at both extremes. What replaced the carbohydrate decided the direction. Swapping carb calories for plant fat and plant protein tracked with **reduced** mortality. Swapping them for animal fat and animal protein tracked with **increased** mortality."
        url="https://pubmed.ncbi.nlm.nih.gov/30122560/"
      />

      <StudyCard
        name="Ma et al.: umbrella review of 124 meta-analyses (Nutrients, 2024)"
        design="Umbrella review"
        participants="Over 5 million pooled"
        duration="Varies by included study"
        finding="It pooled the major cohort reviews. Both very-low-carb and very-low-fat patterns sat alongside **worse outcomes**. Balanced macronutrient intake, within a wide range, sat with the **best** outcomes. Dose-response relationships are **U-shaped** for both carbohydrate and fat."
        url="https://doi.org/10.3390/nu16010152"
      />
    </div>

    <div class="mx-auto max-w-3xl">
      <Callout variant="quote" title="Read the grades, not the vibes">
        Every CookTwo diet guide labels its evidence A (strong), B (moderate), C (limited) or D (insufficient), and links the primary studies. An A must come from randomized trials and consistent cohorts, not from a celebrity's cholesterol panel. When a guide shows a C or D, it says so on the first screen, including on the ones with the biggest marketing budgets. The full grade key is in <a href="#method">How we research</a>.
      </Callout>

      <aside class="not-prose my-10 rounded-2xl border border-sage/40 bg-sage/5 px-6 py-5 sm:px-8">
        <p class="text-xs font-semibold uppercase tracking-widest text-sage-dark mb-2">In short</p>
        <p class="text-lg leading-relaxed text-text-primary">In these studies, the name of the diet mattered less than the quality of the food behind it.</p>
      </aside>
    </div>
  </section>

  <section id="quality" class="container-custom max-w-4xl scroll-mt-36 py-10 md:py-16">
    <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-4">Food quality beats the label</h2>
    <div class="mx-auto max-w-[68ch] space-y-5 text-lg leading-relaxed text-text-primary">
      <p>Two people can follow the same named diet and, a year later, be in two very different places. A big part of that gap comes down to how processed the food is. Nutrition researchers use a classification called <strong class="font-semibold">NOVA</strong>, which sorts food by how much it has been processed, not by its nutrients.</p>
    </div>

    <figure class="not-prose mx-auto my-10 max-w-4xl">
      <img src="/images/diets/article/whole-vs-processed-v2.webp" alt="Overhead view of whole foods on the left (leafy greens, eggs, carrots, beans, fish, lemons, olive oil) and labelled packaged snacks and a soft drink on the right." width="1600" height="1067" loading="lazy" decoding="async" class="w-full h-auto rounded-2xl border border-border shadow-sm" />
      <figcaption class="mt-3 text-sm leading-relaxed text-text-secondary">Illustration: whole foods on the left, labelled ultra-processed packs on the right. Both sides are food. Only one comes with an ingredient list you need to decode.</figcaption>
    </figure>

    <figure class="not-prose my-10 rounded-2xl border border-border bg-white p-6 sm:p-8 shadow-sm">
      <ol class="grid gap-4 md:grid-cols-2">
        {[
          { n: '1', t: 'Unprocessed or minimally processed', d: 'Edible things from plants and animals: vegetables, beans, eggs, meat, milk.', bg: 'bg-sage-dark' },
          { n: '2', t: 'Culinary ingredients', d: 'Cooking ingredients: oil, salt, sugar.', bg: 'bg-sage' },
          { n: '3', t: 'Processed foods', d: 'Simple combinations like bread, cheese and canned fish.', bg: 'bg-terracotta' },
          { n: '4', t: 'Ultra-processed', d: 'Industrial formulations built from extracted substances and additives: soft drinks, snack packs, instant noodles, most breakfast cereals and, yes, a large slice of the "health food" aisle.', bg: 'bg-terracotta-dark' }
        ].map((g) => (
          <li class="flex gap-4 rounded-xl border border-border bg-cream/60 p-4">
            <span class:list={[g.bg, 'flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full text-sm font-bold text-white']}>{g.n}</span>
            <div>
              <p class="font-bold text-text-primary">{g.t}</p>
              <p class="mt-1 text-sm leading-relaxed text-text-secondary">{g.d}</p>
            </div>
          </li>
        ))}
      </ol>
      <figcaption class="mt-5 text-sm leading-relaxed text-text-secondary"><strong class="font-semibold text-text-primary">Figure 1.</strong> The four NOVA groups, ordered from least to most processed. Group 4 is the one the research keeps flagging.</figcaption>
    </figure>

    <div class="mx-auto max-w-[68ch] space-y-5 text-lg leading-relaxed text-text-primary">
      <p>The research gives three reasons why processing matters so much.</p>
    </div>

    <figure class="not-prose my-10">
      <div class="grid md:grid-cols-3 gap-5">
        {[
          { n: '1', t: 'The calorie experiment', d: "Hall's metabolic-ward trial put matched macros on two shelves. Whole food produced spontaneous under-eating of about 500 calories a day. The ultra-processed shelf produced over-eating, which happened before fullness registered." },
          { n: '2', t: '45 meta-analyses, one pattern', d: 'The 2024 BMJ umbrella review found dose-response links between ultra-processed food intake and cardiovascular disease, type 2 diabetes, obesity, several cancers, depression and mortality, across about 10 million people.' },
          { n: '3', t: 'The food matrix', d: 'Two foods with identical nutrition labels can digest differently. Intact cell structure slows how fast you eat, feeds gut bacteria and triggers satiety hormones. Pulverized industrial food skips all three.' }
        ].map((q) => (
          <div class="rounded-2xl border border-border bg-white p-6 shadow-sm">
            <p class="w-9 h-9 rounded-full bg-sage text-white font-bold flex items-center justify-center mb-3">{q.n}</p>
            <p class="font-bold text-text-primary">{q.t}</p>
            <p class="mt-1.5 text-sm text-text-secondary leading-relaxed">{q.d}</p>
          </div>
        ))}
      </div>
      <figcaption class="mt-4 text-sm leading-relaxed text-text-secondary"><strong class="font-semibold text-text-primary">Figure 2.</strong> Three reasons the same nutrition label can lead to different results.</figcaption>
    </figure>

    <aside class="not-prose mx-auto my-10 max-w-3xl rounded-2xl border-l-4 border-terracotta/60 bg-terracotta/5 p-6">
      <p class="text-xs font-semibold uppercase tracking-widest text-terracotta-dark mb-2">From the gym floor</p>
      <p class="text-text-primary leading-relaxed">Two people I worked with ran "keto" the same year. One ran it on shakes, bars and keto-branded snacks; the other ran it on eggs, fish, olive oil and vegetables. Same name, near-identical macros on paper. Six months in, you would have guessed they were following two different planets. The one still thriving at twelve months was the one whose food needed the least marketing.</p>
    </aside>

    <div class="mx-auto max-w-[68ch] space-y-5 text-lg leading-relaxed text-text-primary">
      <p>This is why the diet wars are mostly noise. Almost every named diet (keto, paleo, vegan, Mediterranean, DASH, Whole30) quietly agrees on one instruction: <strong class="font-semibold">stop eating most ultra-processed food.</strong> From an evidence standpoint, that shared agreement does more of the work than the differences between the diets.</p>
    </div>

    <aside class="not-prose mx-auto my-10 max-w-3xl rounded-2xl border border-sage/40 bg-sage/5 px-6 py-5 sm:px-8">
      <p class="text-xs font-semibold uppercase tracking-widest text-sage-dark mb-2">In short</p>
      <p class="text-lg leading-relaxed text-text-primary">Two diets with the same name can behave like two different diets. Check how processed the food is before you check the macro split.</p>
    </aside>
  </section>

  <section id="map" class="container-custom max-w-4xl scroll-mt-36 py-10 md:py-16">
    <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-4">Long-lived populations don't share a macro ratio</h2>
    <div class="mx-auto max-w-[68ch] space-y-5 text-lg leading-relaxed text-text-primary">
      <p>If one macro ratio unlocked long life, you would expect to see it in a long-lived population eating that ratio. Instead, the pattern shows up at every ratio, always on the same foundation. Table 1 shows five examples. Read each row as a whole way of eating, not as a macro target.</p>
    </div>

    <figure class="not-prose mx-auto my-10 max-w-4xl">
      <img src="/images/diets/article/shared-table.webp" alt="A rustic wooden table with bowls of white beans, roasted sweet potatoes, leafy greens, bread, olives, lentils, soybeans, a jug of olive oil and a wedge of cheese." width="1600" height="1067" loading="lazy" decoding="async" class="w-full h-auto rounded-2xl border border-border shadow-sm" />
      <figcaption class="mt-3 text-sm leading-relaxed text-text-secondary">Illustration: the simple building blocks that appear again and again in the diets in Table 1.</figcaption>
    </figure>

    <figure class="not-prose my-10 overflow-hidden rounded-2xl border border-border bg-white shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse min-w-[640px]">
          <thead>
            <tr class="bg-cream-dark">
              <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-text-secondary border-b border-border">Population</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-text-secondary border-b border-border">Approx. carb / fat / protein</th>
