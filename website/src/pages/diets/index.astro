---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Faq from '../../components/prose/Faq.astro';
import StudyCard from '../../components/diets/StudyCard.astro';
import SharedPrinciples from '../../components/diets/SharedPrinciples.astro';
import DietSpectrum from '../../components/diets/DietSpectrum.astro';
import DietCard from '../../components/diets/DietCard.astro';
import SourceList from '../../components/diets/SourceList.astro';
import EarlyAccessButton from '../../components/forms/EarlyAccessButton.astro';
import Callout from '../../components/prose/Callout.astro';
import { DIETS } from '../../data/diets';
import { DIET_CATEGORY_ORDER, DIET_GUIDES } from '../../data/diet-guides';

const title = 'Any Sensible Diet Can Work. Here Is What the Evidence Says | CookTwo';
const description = 'Keto, low-carb, high-carb, low-fat, vegan, paleo — the research keeps pointing at the same thing: food quality, nutrient adequacy and adherence decide whether a diet is healthy.';
const pubDate = new Date('2026-11-02');

const dietsById = new Map(DIETS.map((d) => [d.dietKey, d]));
const published = await getCollection('diets', ({ data }) => data.draft !== true);
const publishedKeys = new Set(published.map((entry) => entry.id));
// published paths use entry.id as slug, guide rows are keyed by dietKey
const slugByKey = new Map(published.map((entry) => [`/${entry.id}`, entry.id]));
// Build ordered guide rows sorted by hub categories then label
const orderedGuides = DIET_CATEGORY_ORDER.flatMap((cat) =>
  DIET_GUIDES
    .filter((g) => g.category === cat.id && dietsById.has(g.dietKey))
    .map((g) => ({ row: g, diet: dietsById.get(g.dietKey) as (typeof DIETS)[number] }))
);

const faqs = [
  { q: 'Can any diet be healthy?', a: 'Any sensible diet can be healthy when it is built from whole foods, meets your protein, fibre and micronutrient needs, and you can sustain it. Randomized trials directly comparing well-constructed low-carb and low-fat diets found near-identical weight loss, and landmark cohorts show the healthiest carbohydrate window sits in the moderate middle. What reliably harms: ultra-processed food, nutrient gaps, and extremes nobody can maintain. Extreme elimination patterns — carnivore, 80/10/10 — have weak evidence and belong in a different category entirely.' },
  { q: 'What matters more: the diet or the food quality?', a: 'Food quality, and it is not close. In the most controlled study ever run on this question, people ate 508 more calories a day and gained weight on an ultra-processed diet even though its nutrition label matched the whole-food diet they lost weight on. The same calories and macros in different food packages produced a 1,000-calorie swing. Processing level beats macro ratio as the health variable.' },
  { q: 'Which diet has the strongest evidence?', a: 'The Mediterranean diet, with multiple large randomized trials including a ~30% reduction in major cardiovascular events in the PREDIMED study, followed by DASH, which deliberately lowered blood pressure in landmark trials. Several others — keto, low FODMAP, plant-based — have grade-A or solid evidence within specific uses. No diet is best at everything, and "strongest evidence" depends what outcome you count.' },
  { q: 'Why do nutrition studies seem to contradict each other?', a: 'Because they measure different things at different strengths. Randomized controlled trials test cause-and-effect for months. Cohort studies follow hundreds of thousands of people for years but only show association. Both are honest; both have blind spots. This guide grades every claim so you can see which kind of evidence sits behind it.' },
  { q: 'Is a high-carb diet unhealthy?', a: 'Whole-food carbohydrate is not. Two of the longest-lived populations in documented history — Okinawa at roughly 85% carbohydrate and Sardinia at roughly 50% — sat at opposite ends of the fat scale and both lived long. What harms is refined, starch-milled, sugar-laden carbohydrate. The 2018 Lancet Public Health analysis found mortality lowest at 50–55% carbohydrate, rising at the extremes.' },
  { q: 'What should I do if my partner and I follow different diets?', a: 'Pick whichever evidence-backed pattern fits your health goal — or keep one flexible base and adapt each plate. CookTwo is built for exactly this: one shared recipe, personalised portions and diet adaptations per plate from the same handful of ingredients.' }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }))
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://cooktwo.com/' },
    { '@type': 'ListItem', position: 2, name: 'Diet evidence', item: 'https://cooktwo.com/diets/' }
  ]
};

const itemSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'CookTwo diet evidence guides',
  itemListElement: DIET_CATEGORY_ORDER.flatMap((cat) =>
    DIET_GUIDES
      .filter((g) => g.category === cat.id && dietsById.has(g.dietKey))
      .map((g) => ({
        '@type': 'ListItem',
        name: (dietsById.get(g.dietKey) as (typeof DIETS)[number]).displayLabel,
        url: `https://cooktwo.com${g.href}/`
      }))
  )
};

const tocItems = [
  ['story', 'The view from the gym floor'],
  ['the-short-answer', 'The short answer'],
  ['evidence', 'What the evidence shows'],
  ['quality', 'Food quality beats the label'],
  ['map', 'The proof is on the map'],
  ['fundamentals', 'What every healthy diet shares'],
  ['spectrum', 'The diet spectrum'],
  ['catalog', 'Compare all 25 diet guides'],
  ['judge', 'How to judge any diet'],
  ['limits', 'When a diet is not okay'],
  ['method', 'How we research'],
  ['faq', 'Common questions']
] as const;
---

<BaseLayout title={title} description={description} ogImage="/images/diets/og/diet-hub.webp" canonicalURL="/diets" isArticle={true} articlePublishedDate={pubDate.toISOString()} articleAuthor="Vary (personal trainer)" articleTags={['diets', 'nutrition evidence', 'food quality']}>
  {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>}
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>}
  {itemSchema && <script type="application/ld+json" set:html={JSON.stringify(itemSchema)}></script>}

  <nav aria-label="On this page" class="sticky top-20 z-30 bg-cream/85 backdrop-blur-md border-b border-border">
    <div class="container-custom max-w-6xl">
      <ul class="flex items-center gap-1 overflow-x-auto py-3 text-sm font-medium no-scrollbar">
        <li class="text-text-secondary/70 whitespace-nowrap pr-2 hidden sm:block">On this page:</li>
        {tocItems.map(([id, label]) => (
          <li><a href={`#${id}`} class="whitespace-nowrap px-3 py-1.5 rounded-lg text-text-secondary hover:text-sage-dark hover:bg-sage/5 transition-colors">{label}</a></li>
        ))}
      </ul>
    </div>
  </nav>

  <section class="container-custom max-w-6xl pt-12 pb-6 md:pt-20">
    <span class="badge-signature mb-6 inline-block">Diet evidence</span>
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-text-primary leading-tight mb-6">Any sensible diet can work.<br/><span class="text-sage">Here is what the evidence says.</span></h1>
    <p class="text-xl md:text-2xl text-text-secondary leading-relaxed max-w-3xl mb-8">
      Keto, low-carb, high-carb, low-fat, vegan, paleo — the internet turns diets into rival teams, and gyms spend all day refereeing the fights. The research quietly refuses to pick a side. Across landmark randomized trials, ten-million-person reviews and five continents of traditional eating, the variable that separates healthy diets from unhealthy ones is not the name of the plan. It is the quality of the food going in, whether the nutrients actually arrive, and whether a human being can keep the thing going. I have watched that truth play out with every client I have ever trained — and watched the diet wars ignore it with equal consistency.
    </p>
    <div class="flex flex-wrap items-center gap-3 text-sm text-text-secondary mb-4">
      <span>Vary — personal trainer, writing with the CookTwo research desk</span>
      <span aria-hidden="true">·</span>
      <time datetime={pubDate.toISOString()}>November 2, 2026</time>
      <span aria-hidden="true">·</span>
      <span>19 min read</span>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-8">
      {[
        { v: '25', l: 'diet evidence guides', s: 'every pattern in the CookTwo app' },
        { v: '6', l: 'landmark studies below', s: 'DIETFITS, PURE, Hall & PREDIMED' },
        { v: '5', l: 'fundamentals that decide', s: 'the same in every food culture' },
        { v: '1', l: 'sentence of relief', s: 'you do not have to be perfect' }
      ].map((s) => (
        <div class="bg-white rounded-2xl border border-border p-5 shadow-sm text-center">
          <p class="text-3xl md:text-4xl font-bold text-sage tracking-tight">{s.v}</p>
          <p class="text-sm font-semibold text-text-primary mt-1.5">{s.l}</p>
          <p class="text-xs text-text-secondary mt-0.5">{s.s}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="story" class="container-custom max-w-4xl py-10 md:py-14">
    <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-6">The view from the gym floor</h2>
    <p class="text-lg text-text-primary leading-relaxed mb-5">
      I have one quiet advantage over most people who publish diet opinions: I keep score after they stop talking. Personal training is where nutrition arguments hit contact with real life. A new client arrives carrying the diet they were most recently convinced by — a keto notebook, a screenshot of a fasting window, a shelf of branded shakes — and a few weeks later we both find out what the diet is actually made of, and whether a human being can live inside it.
    </p>
    <p class="text-lg text-text-secondary leading-relaxed mb-5">
      Early in my career I made the classic mistake. I had my one plan, and I tried to file every client into it. Some agreed and did well. Others pushed back, kept their own eating — vegan, keto, plain "normal food" — and did just as well, provided the plan ran on real food and they genuinely liked living in it. No diet name ever predicted who would thrive. The fit between plan and person did, and so did the quality of the construction.
    </p>
    <p class="text-lg text-text-secondary leading-relaxed mb-5">
      Years of keeping that score taught me to ask a better question. Not "which diet is best?" but "what does this diet share with every other one that worked?" So I sat down with the research, expecting it to finally crown a winner. It refused. Five landmark studies and one map, which you will meet below, say the same thing the gym floor already knew: the name of the plan is close to irrelevant. The construction is everything.
    </p>
    <p class="text-lg text-text-primary leading-relaxed">
      What follows is that evidence, the shared floor every healthy diet stands on, honest evidence grades for every pattern CookTwo supports, and the questions I now run every client through before they commit to any plan. The short version is next, because you're busy.
    </p>
  </section>

  <section id="the-short-answer" class="container-custom max-w-6xl py-10 md:py-14">
    <div class="rounded-2xl border-2 border-sage/60 bg-sage/5 p-6 sm:p-10">
      <p class="text-xs font-semibold uppercase tracking-widest text-sage-dark mb-3">The short answer</p>
      <p class="text-xl md:text-2xl leading-relaxed text-text-primary">
        <strong>Almost any sensible diet can be healthy.</strong> Trials that built a good low-carb diet and a good low-fat diet found the same weight loss at a year. The largest cohort ever assembled found the safest carbohydrate window in the moderate middle, not at an extreme. The most controlled feeding study ever run found that people gain weight on a matching-calorie ultra-processed diet and lose weight on whole food. And every long-lived population on earth, at every possible macro ratio, ate real food, moved a lot, and stayed at it for a lifetime.
      </p>
      <p class="mt-4 text-text-primary leading-relaxed">
        That is the thesis of this hub — and every one of the <a href="#catalog" class="text-sage-dark font-medium hover:text-sage underline decoration-sage/40 underline-offset-2">25 diet guides</a> below applies it honestly, including where the science is thin and where an honest writer must say "no".
      </p>
    </div>
  </section>

  <section id="evidence" class="container-custom max-w-6xl py-10 md:py-16">
    <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-4">What the evidence actually shows</h2>
    <p class="text-lg text-text-secondary leading-relaxed max-w-3xl mb-8">
      I went looking for a winner — the one study that crowned the right diet name and finished the argument for good. Five landmark studies and one map later, I had finished with the argument instead. Not one of them cares about macro ratios the way the internet does. Together they explain exactly why the diet wars never resolve, and why the people quietly winning are not the people arguing.
    </p>

    <StudyCard name="DIETFITS — a healthy low-carb diet vs a healthy low-fat diet (JAMA, 2018)" design="Randomized controlled trial" participants="609 adults" duration="12 months" finding="Weight loss came out nearly identical — about 5–6 kg in both groups — and each person's baseline insulin sensitivity did not predict which diet worked better for them. Both diets were built from whole food and both cut sugar and refined flour." url="https://pubmed.ncbi.nlm.nih.gov/29490351/" />

    <aside class="not-prose my-8 rounded-2xl border-l-4 border-terracotta/60 bg-terracotta/5 p-6">
      <p class="text-xs font-semibold uppercase tracking-widest text-terracotta-dark mb-2">From the gym floor</p>
      <p class="text-text-primary leading-relaxed">I have watched a devoted low-carber and a devoted high-carber land on nearly the same results in the same training block. Both plans ran on real food, both hit their protein, and both were being followed by people who had genuinely chosen them. Neither one needed to win an argument with the other. That is DIETFITS with faces on it.</p>
    </aside>

    <StudyCard name="Hall et al. — the NIH inpatient ultra-processed diet trial (Cell Metabolism, 2019)" design="Randomized crossover, metabolic ward" participants="20 adults" duration="2 weeks per arm" finding="With calories, macros, sugar, fibre and sodium matched, a nearly-identical nutrition label hid a 508 kcal/day difference: people over-ate and gained weight on the ultra-processed version and lost weight on the whole-food version. Processing level — not the macro maths — overrode satiety." url="https://pubmed.ncbi.nlm.nih.gov/31195085/" />

    <StudyCard name="PURE — 135,000 people across 18 countries (The Lancet, 2017)" design="Prospective cohort" participants="135,335 adults, 5 continents" duration="Median 7.4 years" finding="High carbohydrate intake above 60% of energy — mostly from refined staples — tracked with higher total mortality. Total fat, including saturated fat, tracked with lower. Neither is a hero or villain; the extremes and the refining are the problem." url="https://doi.org/10.1016/S0140-6736(17)32252-3" />

    <StudyCard name="Seidelmann et al. — the carbohydrate U-curve (Lancet Public Health, 2018)" design="Cohort + meta-analysis" participants="432,179 adults" duration="~25 years" finding="Mortality was lowest at 50–55% carbohydrate and rose at both extremes. Crucially, what replaced the carbohydrate decided the direction: swapping carb calories for plant fat and plant protein tracked with reduced mortality; swapping them for animal fat and animal protein tracked with increased." url="https://pubmed.ncbi.nlm.nih.gov/30122560/" />

    <StudyCard name="Ma et al. — the umbrella review of 124 meta-analyses (Nutrients, 2024)" design="Umbrella review" participants="Over 5 million pooled" duration="—" finding="Pulled every major cohort review together: both very-low-carb and very-low-fat patterns sit alongside worse outcomes; balanced macronutrient intake — within a wide range — sits with the best. Dose-response relationships are U-shaped for both carbohydrate and fat." url="https://doi.org/10.3390/nu16010152" />

    <Callout variant="quote" title="Read the grades, not the vibes">
      Every CookTwo diet guide labels its evidence A (strong), B (moderate), C (limited) or D (insufficient), and links the primary studies. A's must come from randomized trials and consistent cohorts, not from a celebrity's cholesterol panel. When a diet guide shows grade C or D, it says so in the first screen — including on the ones with the biggest marketing budgets.
    </Callout>
  </section>

  <section id="quality" class="container-custom max-w-6xl py-10 md:py-16 bg-white/0">
    <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-4">Food quality beats the label</h2>
    <p class="text-lg text-text-secondary leading-relaxed max-w-3xl mb-8">
      Two people can run the same named diet and end up in two different bodies a year later — I have watched it happen more times than I can count. Nutrition science has a name for the variable that explains most of it: NOVA. It sorts food by how processed it is, not by nutrient. Group 1 is edible things from plants and animals — vegetables, beans, eggs, meat, milk. Group 2 is cooking ingredients — oil, salt, sugar. Group 3 is simple combinations like bread, cheese and canned fish. Group 4 is the industrial formulation, built from extracted substances and additives: soft drinks, snack packs, instant noodles, most breakfast cereals, and yes, a large slice of the "health food" aisle.
    </p>
    <div class="grid md:grid-cols-3 gap-5 mb-6">
      {[
        { n: '1', t: 'The calorie experiment', d: "Hall's metabolic-ward trial put matched macros on two shelves. Whole food produced spontaneous 500-calorie/day under-eating. The ultra-processed shelf produced over-eating — eating that happens before fullness registers." },
        { n: '2', t: 'The 45-meta-analysis pile-up', d: 'The 2024 BMJ umbrella review found dose-response links between ultra-processed food intake and cardiovascular disease, type 2 diabetes, obesity, several cancers, depression and mortality — across about 10 million people.' },
        { n: '3', t: 'The food matrix', d: 'Two foods with identical nutrition labels can digest differently. Intact cellular structure slows eating-rate, feeds gut bacteria and triggers satiety hormones. Pulverized industrial food skips all three.' }
      ].map((q) => (
        <div class="rounded-2xl border border-border bg-white p-6 shadow-sm">
          <p class="w-9 h-9 rounded-full bg-sage text-white font-bold flex items-center justify-center mb-3">{q.n}</p>
          <p class="font-bold text-text-primary">{q.t}</p>
          <p class="mt-1.5 text-sm text-text-secondary leading-relaxed">{q.d}</p>
        </div>
      ))}
    </div>
    <aside class="not-prose my-8 rounded-2xl border-l-4 border-terracotta/60 bg-terracotta/5 p-6">
      <p class="text-xs font-semibold uppercase tracking-widest text-terracotta-dark mb-2">From the gym floor</p>
      <p class="text-text-primary leading-relaxed">Two people I worked with ran "keto" the same year. One ran it on shakes, bars and keto-branded snacks; the other ran it on eggs, fish, olive oil and vegetables. Same name, near-identical macros on paper. Six months in, you would have guessed they were following two different planets. The one still thriving at twelve months was the one whose food needed the least marketing.</p>
    </aside>
    <p class="text-lg text-text-primary leading-relaxed max-w-3xl">
      This is why the diet wars are noise. Almost every named diet — keto, paleo, vegan, Mediterranean, DASH, Whole30 — quietly agrees on one instruction: <strong>stop eating most ultra-processed food.</strong> From an evidence standpoint, that agreement is doing more of the work than the differences.
    </p>
  </section>

  <section id="map" class="container-custom max-w-6xl py-10 md:py-16">
    <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-4">The proof is on the map — not in the podium fight</h2>
    <p class="text-lg text-text-secondary leading-relaxed max-w-3xl mb-8">
      If one macro ratio unlocked longevity, it would show up as one long-lived population eating that ratio. Instead it shows up everywhere, at every ratio, always on the same foundation.
    </p>
    <div class="not-prose my-8 overflow-x-auto rounded-2xl border border-border bg-white shadow-sm">
      <table class="w-full text-sm border-collapse min-w-[640px]">
        <caption class="sr-only">Long-lived population diets differing in macro ratio</caption>
        <thead>
          <tr class="bg-cream-dark">
            <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-text-secondary border-b border-border">Population</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-text-secondary border-b border-border">Approx. carb / fat / protein</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-text-secondary border-b border-border">The distillation</th>
          </tr>
        </thead>
        <tbody>
          <tr><td class="px-4 py-3 border-b border-border font-semibold text-text-primary">Okinawa, Japan</td><td class="px-4 py-3 border-b border-border">~85 / ~6 / ~9 — sweet potato, soy, vegetables</td><td class="px-4 py-3 border-b border-border text-text-secondary">Very-high-carb, extremely low-fat, very-low-protein. Longevity record: among the world's best.</td></tr>
          <tr><td class="px-4 py-3 border-b border-border font-semibold text-text-primary">Ikaria, Greece</td><td class="px-4 py-3 border-b border-border">~45 / ~40 / ~15 — olive oil, greens, legumes, goat</td><td class="px-4 py-3 border-b border-border text-text-secondary">Higher-fat Mediterranean pattern. More than twice the expected rate of reaching 90.</td></tr>
          <tr><td class="px-4 py-3 border-b border-border font-semibold text-text-primary">Sardinia, Italy</td><td class="px-4 py-3 border-b border-border">~50 / ~30 / ~15 — barley bread, beans, pecorino, wine</td><td class="px-4 py-3 border-b border-border text-text-secondary">Includes daily saturated fat and alcohol. Highest documented male centenarian rate on earth.</td></tr>
          <tr><td class="px-4 py-3 border-b border-border font-semibold text-text-primary">Nicoya, Costa Rica</td><td class="px-4 py-3 border-b border-border">~60 / ~20 / ~18 — beans, corn, squash, eggs, pork</td><td class="px-4 py-3 border-b border-border text-text-secondary">A moderate middle: home cooking, low processing, ~20% lower mortality than the rest of the country.</td></tr>
          <tr><td class="px-4 py-3 border-b border-border font-semibold text-text-primary">Loma Linda, USA</td><td class="px-4 py-3 border-b border-border">~55 / ~30 / ~15 — plant-forward, nuts, legumes, whole grains</td><td class="px-4 py-3 border-b border-border text-text-secondary">The Adventist cohort: 7–10 years of extra life expectancy, in America.</td></tr>
        </tbody>
      </table>
    </div>
    <aside class="not-prose my-8 rounded-2xl border-l-4 border-terracotta/60 bg-terracotta/5 p-6">
      <p class="text-xs font-semibold uppercase tracking-widest text-terracotta-dark mb-2">From the gym floor</p>
      <p class="text-text-primary leading-relaxed">The fittest people past seventy I have ever worked with did not share a macro ratio either. One cooked the way her mother had in Greece — olive oil, greens, beans, a table full of people. One ate the way her family always had — rice, vegetables, soy, small plates. They shared two things: a kitchen somebody actually cooked in, and bodies that moved nearly every day. When I finally read the longevity research, I recognised the pattern before I finished the first page.</p>
    </aside>
    <p class="text-lg text-text-primary leading-relaxed max-w-3xl">
      Not a single healthy long-lived population ran on ultra-processed food. Not one ran on a diet that granted nothing to a human body or soul. If macro ratios were the key, Okinawa and Ikaria could not share a planet.
    </p>
  </section>

  <section id="fundamentals" class="container-custom max-w-6xl py-10 md:py-16">
    <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-4">What every healthy diet shares</h2>
    <p class="text-lg text-text-secondary leading-relaxed max-w-3xl mb-6">
      For years I asked the wrong question whenever a client succeeded: "what made their diet the winner?" The better question — "what did their plan have in common with every other plan that succeeded?" — shrank the answer fast. Strip the brands off the five healthiest diets on earth, or the five longest-lived towns, and the same five fundamentals are running underneath. Trade between them freely.
    </p>
    <SharedPrinciples />
  </section>

  <section id="spectrum" class="container-custom max-w-6xl py-10 md:py-16">
    <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-4">The diet spectrum</h2>
    <p class="text-lg text-text-secondary leading-relaxed max-w-3xl mb-8">
      After enough gym-floor years, I stopped being impressed by which diet people declared and started noticing where it sat. This grid is that observation, drawn out. Pick a cell — any cell — and evidence-backed eating exists inside it. The position tells you where a pattern pins its macro ratio; the colour tells you how much evidence carries it. Colours mark evidence strength, not moral worth. Grades are explained below the map.
    </p>
    <DietSpectrum chips={[
      { label: 'Keto', href: '/diets/keto', row: 4, col: 1, grade: 'B' },
      { label: 'Carnivore', href: '/diets/carnivore', row: 4, col: 1, grade: 'D' },
      { label: 'Paleo', href: '/diets/paleo', row: 4, col: 2, grade: 'C' },
      { label: 'Whole30', href: '/diets/whole30', row: 4, col: 2, grade: 'C-D' },
      { label: 'High-protein', href: '/diets/high-protein', row: 3, col: 2, grade: 'B' },
      { label: 'Mediterranean', href: '/diets/mediterranean', row: 3, col: 3, grade: 'A' },
      { label: 'Healthy eating', href: '/diets/healthy-eating', row: 2, col: 3, grade: 'A' },
      { label: 'Flexitarian', href: '/diets/flexitarian', row: 3, col: 3, grade: 'B-C' },
      { label: 'Pescatarian', href: '/diets/pescatarian', row: 3, col: 3, grade: 'A' },
      { label: 'Low FODMAP', href: '/diets/low-fodmap', row: 3, col: 3, grade: 'B' },
      { label: 'Gluten-free*', href: '/diets/gluten-free', row: 3, col: 3, grade: 'A' },
      { label: 'DASH', href: '/diets/dash', row: 2, col: 3, grade: 'A' },
      { label: 'Plant-based', href: '/diets/plant-based', row: 2, col: 3, grade: 'B' },
      { label: 'Vegan', href: '/diets/vegan', row: 2, col: 3, grade: 'A' },
      { label: 'Vegetarian', href: '/diets/vegetarian', row: 2, col: 3, grade: 'A' },
      { label: 'MIND', href: '/diets/mind', row: 2, col: 3, grade: 'B' },
      { label: 'Volumetrics', href: '/diets/volumetrics', row: 2, col: 3, grade: 'B-C' },
