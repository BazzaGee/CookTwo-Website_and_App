---
import BaseLayout from '../layouts/BaseLayout.astro';
import KitchenTool from '../components/tool/KitchenTool.astro';
---

<BaseLayout
  title="The CookTwo Kitchen Tool — Smart Pantry, Shopping List & Daily Calories | CookTwo"
  description="A free interactive tool: type out your pantry and watch it sort itself, build a smart shopping list, and see your daily calorie target. Runs entirely in your browser — no account needed."
  minimal
  chatEndpoint="/api/tool-chat"
  chatTitle="App AI Assistant"
  chatSubtitle=""
  chatShowLogo={false}
  chatWelcome={'Hi! 👋 I’m the App AI Assistant for this Kitchen Tool. Ask me anything about how it works — the shopping list, pantry, your plate, or your diet. Questions about the full CookTwo app are welcome too.'}
  chatPlaceholder="Ask how this tool works…"
  chatSource="tool-solo"
>
  <KitchenTool audience="solo" />
</BaseLayout>
