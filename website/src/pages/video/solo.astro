---
import VslPlayer from '../../components/funnel/VslPlayer.astro';
import { revealFor } from '../../lib/reveal-at';

// Single source: src/data/vsl-reveal.json. Do not paste the number here.
const reveal = revealFor('solo');
---

<!--
  Reveal at 500.03s = 00:08:20,030 — slide #189, the opt-in box.
  The value lives in src/data/vsl-reveal.json (source: timecodes.csv row 189),
  verified 2026-10-23 against the rendered frames either side of the boundary.
-->
<VslPlayer
  slug="solo-finale"
  mode="solo"
  revealAt={reveal.revealAt}
  title="Watch — dinners on your own schedule"
  description="What one week of dinners looks like when the kitchen is all yours."
/>
