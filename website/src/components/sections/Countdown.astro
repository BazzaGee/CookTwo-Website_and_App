---
interface Props {
  title?: string;
  eyebrow?: string;
}
const {
  title = 'Premium goes live 1 November 2026',
  eyebrow = 'Changeover',
} = Astro.props;

const TARGET_MS = Date.UTC(2026, 10, 1, 0, 0, 0);
const pad = (n: number) => String(n).padStart(2, '0');

const remaining = Math.max(0, TARGET_MS - Date.now());
const days = Math.floor(remaining / 86400000);
const hours = Math.floor((remaining % 86400000) / 3600000);
const minutes = Math.floor((remaining % 3600000) / 60000);
const seconds = Math.floor((remaining % 60000) / 1000);

const tiles = [
  { key: 'days', value: String(days), unit: days === 1 ? 'day' : 'days' },
  { key: 'hours', value: pad(hours), unit: hours === 1 ? 'hour' : 'hours' },
  { key: 'minutes', value: pad(minutes), unit: minutes === 1 ? 'minute' : 'minutes' },
  { key: 'seconds', value: pad(seconds), unit: seconds === 1 ? 'second' : 'seconds' },
];
---

<div
  data-countdown="pricing"
  data-target="2026-11-01T00:00:00Z"
  role="timer"
  aria-live="off"
  class="mb-10 max-w-3xl mx-auto"
>
  <div class="rounded-2xl border border-sage/40 bg-white p-6 md:p-7 shadow-sm">
    <div class="flex flex-col items-center gap-5 md:flex-row md:justify-between md:gap-8">
      <div class="text-center md:text-left">
        <span class="badge-signature mb-3 inline-block">{eyebrow}</span>
        <p class="text-lg md:text-xl font-bold text-text-primary leading-snug">{title}</p>
        <p class="text-sm text-text-secondary mt-1.5">Free stays free. Both tiers below are available today.</p>
        <p class="sr-only">Countdown to 1 November 2026 at 00:00 UTC.</p>
      </div>

      <div class="flex items-stretch gap-2 md:gap-3">
        {tiles.map((tile) => (
          <div class="flex-1 min-w-[68px] md:min-w-[76px] text-center bg-cream border border-border rounded-xl px-2 py-3">
            <p
              data-unit={tile.key}
              class="text-2xl md:text-3xl font-bold text-sage tabular-nums leading-none"
            >{tile.value}</p>
            <p class="text-[11px] uppercase tracking-wide text-text-secondary mt-1.5">{tile.unit}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-countdown="pricing"]');
    if (!root) return;

    var target = Date.parse(root.getAttribute('data-target') || '');
    if (isNaN(target)) return;

    var cells = {
      days: root.querySelector('[data-unit="days"]'),
      hours: root.querySelector('[data-unit="hours"]'),
      minutes: root.querySelector('[data-unit="minutes"]'),
      seconds: root.querySelector('[data-unit="seconds"]'),
    };

    function pad(n) {
      return n < 10 ? '0' + n : String(n);
    }

    function render() {
      var remaining = target - Date.now();

      if (remaining <= 0) {
        clearInterval(timer);
        root.remove();
        return true;
      }

      var days = Math.floor(remaining / 86400000);
      var hours = Math.floor((remaining % 86400000) / 3600000);
      var minutes = Math.floor((remaining % 3600000) / 60000);
      var seconds = Math.floor((remaining % 60000) / 1000);

      if (cells.days) cells.days.textContent = String(days);
      if (cells.hours) cells.hours.textContent = pad(hours);
      if (cells.minutes) cells.minutes.textContent = pad(minutes);
      if (cells.seconds) cells.seconds.textContent = pad(seconds);

      return false;
    }

    if (render()) return;
    var timer = setInterval(render, 1000);
  })();
</script>
