---
/**
 * Factor quiz — the 3-5 step funnel that feeds one factor's VSL.
 *
 * Same chrome and behaviour as FunnelQuiz (chips auto-advance, progress
 * segments, 20 s countdown into the video), but data-driven: the page passes
 * its own steps and its own video path. Every answer set routes to THIS
 * factor's video — the quiz exists to warm the viewer for that letter.
 *
 * No email is asked for. If the link carries ?e={address} (campaign links do)
 * it is attached silently and the answer set is tagged on the contact.
 */
interface Choice { id: string; label: string }
interface Step {
  kicker: string;
  question: string;
  micro?: string;
  choices: Choice[];
}
interface Props {
  factor: string;
  steps: Step[];
  videoPath: string;
  thankyouHead?: string;
  thankyouSub: string;
  ctaLabel?: string;
}

const {
  factor,
  steps,
  videoPath,
  thankyouHead = 'All set — your video is queued.',
  thankyouSub,
  ctaLabel = 'Watch it now',
} = Astro.props;
const total = steps.length;
---

<div
  class="quiz"
  id="funnel-quiz"
  data-step="1"
  data-factor={factor}
  data-video={videoPath}
  data-total={total}
>
  <header class="progress">
    <div class="track" aria-hidden="true">
      {steps.map((_, i) => <span class:list={['seg', i === 0 && 'done']} />)}
    </div>
    <button type="button" class="back" id="quiz-back" hidden>&larr; Back</button>
  </header>

  <main class="stage">
    {steps.map((s, i) => (
      <section
        class:list={['step', i === 0 && 'is-active']}
        data-step={i + 1}
        hidden={i !== 0}
      >
        <p class="kicker">{s.kicker}</p>
        <h1>{s.question}</h1>
        {s.micro && <p class="micro">{s.micro}</p>}
        <div class="chips">
          {s.choices.map((c) => (
            <button type="button" class="chip" data-choice={c.id}>{c.label}</button>
          ))}
        </div>
      </section>
    ))}

    <section class="step thankyou" data-step="done" hidden>
      <h1>{thankyouHead}</h1>
      <p class="sub" id="thank-you-sub">{thankyouSub}</p>
      <div class="countdown" aria-label="Video starting shortly">
        <span class="countdown-bar" id="countdown-bar" />
      </div>
      <p class="meta"><span id="countdown-seconds">20</span>s &middot; sound on</p>
      <a class="watch-now" id="watch-now" href={videoPath}>{ctaLabel} &rarr;</a>
    </section>
  </main>

  <div class="toast" id="quiz-toast" hidden>
    <p>Something didn&rsquo;t come through. <button type="button" class="toast-retry" id="quiz-retry">Try again</button></p>
    <a id="quiz-skip" href={videoPath}>Or watch the video anyway</a>
  </div>

  <noscript>
    <div class="noscript-note">This page needs JavaScript to continue &mdash; or jump straight to <a href={videoPath}>the video</a>.</div>
  </noscript>
</div>

<script>
  import {
    adoptSessionId,
    flush,
    readAttribution,
    setQuizAttemptId,
    sessionId,
    startSession,
    track,
    visitorId,
  } from '../../lib/funnel-tracker';

  (function () {
    'use strict';

    var root = document.getElementById('funnel-quiz');
    if (!root) return;

    var factor = root.getAttribute('data-factor') || '';
    var videoPath = root.getAttribute('data-video') || '/video/app';
    var total = parseInt(root.getAttribute('data-total') || '3', 10) || 3;

    var state = { step: 1, answers: [], email: '', utm: {} };

    var $ = function (sel) { return root.querySelector(sel); };
    var backBtn = $('#quiz-back');
    var toast = $('#quiz-toast');
    var segments = Array.prototype.slice.call(root.querySelectorAll('.track .seg'));

    try {
      var params = new URLSearchParams(window.location.search);
      ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'via'].forEach(function (k) {
        var v = params.get(k);
        if (v) state.utm[k] = v;
      });
      var prefill = params.get('e');
      if (prefill) state.email = prefill.trim();
    } catch (e) { /* no params — fine */ }

    readAttribution({ strip: true });
    startSession({ entry: 'quiz' });

    // ── Step-level tracking: question views + time-to-answer ──────────────
    // Applies to every factor funnel — quiz_type carries the factor id.
    var stepEnteredAt = Date.now();
    function trackStepView(n) {
      if (n < 1 || n > total) return;
      stepEnteredAt = Date.now();
      track('quiz_step_view', { value: factor + '-' + n, meta: { step: n, quiz_type: factor } });
    }
    trackStepView(1);

    function paintProgress(stepNum) {
      var shown = Math.min(Math.max(stepNum, 0), total);
      segments.forEach(function (seg, i) { seg.classList.toggle('done', i < shown); });
      var backVisible = stepNum > 1 && stepNum <= total;
      backBtn.hidden = !backVisible;
      backBtn.style.visibility = backVisible ? 'visible' : 'hidden';
    }

    function goTo(n) {
      state.step = n;
      var done = n > total;
      Array.prototype.forEach.call(root.querySelectorAll('.step'), function (el) {
        var key = el.getAttribute('data-step');
        var active = done ? key === 'done' : key === String(n);
        el.hidden = !active;
        el.classList.toggle('is-active', active);
      });
      paintProgress(done ? total : n);
      if (!done && n >= 1 && n <= total) trackStepView(n);
      if (done) {
        backBtn.hidden = true;
        startCountdown();
      }
    }

    function next() { goTo(state.step + 1); }

    function bindStep(stepNum) {
      var scope = root.querySelector('.step[data-step="' + stepNum + '"]');
      if (!scope) return;
      Array.prototype.forEach.call(scope.querySelectorAll('.chip'), function (chip) {
        chip.addEventListener('click', function () {
          if (scope.classList.contains('is-locked')) return;
          scope.classList.add('is-locked');
          Array.prototype.forEach.call(root.querySelectorAll('.chip.is-selected'), function (n) {
            n.classList.remove('is-selected');
          });
          chip.classList.add('is-selected');
          if (!chip.getAttribute('data-label')) chip.setAttribute('data-label', chip.textContent);
          var value = chip.getAttribute('data-choice') || '';
          state.answers = state.answers.filter(function (a) { return a.q !== stepNum; });
          state.answers.push({ q: stepNum, a: value });
          track('quiz_answer', { value: value, meta: { question: factor + '-' + stepNum, step: stepNum, quiz_type: factor, ms_since_step: Date.now() - stepEnteredAt } });
          if (stepNum === total) {
            chip.setAttribute('aria-busy', 'true');
            chip.textContent = (chip.getAttribute('data-label') || '') + ' — sending…';
            submit();
          } else {
            window.setTimeout(next, 350);
          }
        });
      });
    }

    for (var s = 1; s <= total; s++) bindStep(s);

    var submitting = false;

    function submit() {
      if (submitting) return;
      submitting = true;
      var payload = {
        factor: factor,
        answers: state.answers.slice().sort(function (a, b) { return a.q - b.q; }),
        email: state.email,
        utm: state.utm,
        session_id: sessionId(),
        visitor_id: visitorId(),
      };
      fetch('/api/quiz/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
        .then(function (res) {
          if (!res.ok) throw new Error('HTTP ' + res.status);
          return res.json();
        })
        .then(function (data) {
          submitting = false;
          var redirect = (data && typeof data.redirect === 'string' && data.redirect)
            ? data.redirect
            : videoPath;
          if (data && typeof data.session_id === 'string') adoptSessionId(data.session_id);
          if (data && typeof data.attempt_id === 'string') setQuizAttemptId(data.attempt_id);
          track('quiz_submit', { value: factor });
          flush();
          prepareThankYou(redirect);
          goTo(total + 1);
        })
        .catch(function (err) {
          submitting = false;
          console.error('quiz submit failed:', err);
          if (toast) toast.hidden = false;
        });
    }

    function prepareThankYou(redirect) {
      var link = document.getElementById('watch-now');
      var skip = document.getElementById('quiz-skip');
      if (link) link.setAttribute('href', redirect);
      if (skip) skip.setAttribute('href', redirect);
    }

    var retryBtn = document.getElementById('quiz-retry');
    if (retryBtn) {
      retryBtn.addEventListener('click', function () {
        if (toast) toast.hidden = true;
        submitting = false;
        submit();
      });
    }

    var redirectTarget = '';
    var countdownBound = false;

    function startCountdown() {
      var target = document.getElementById('watch-now');
      redirectTarget = target ? target.getAttribute('href') || videoPath : videoPath;
      if (countdownBound) return;
      countdownBound = true;

      var secondsEl = document.getElementById('countdown-seconds');
      var bar = document.getElementById('countdown-bar');
      var windowMs = 20000;
      var start = Date.now();
      var tail = window.setInterval(function () {
        var elapsed = Date.now() - start;
        var left = Math.max(0, Math.ceil((windowMs - elapsed) / 1000));
        if (secondsEl) secondsEl.textContent = String(left);
        if (bar) bar.style.width = Math.max(0, 100 - (elapsed / windowMs) * 100) + '%';
        if (elapsed >= windowMs) {
          window.clearInterval(tail);
          window.location.assign(redirectTarget);
        }
      }, 100);
    }

    if (backBtn) {
      backBtn.addEventListener('click', function () {
        if (state.step <= 1 || state.step > total) return;
        track('quiz_back', { value: String(state.step), meta: { from: state.step, to: state.step - 1, quiz_type: factor } });
        var target = state.step - 1;
        state.answers = state.answers.filter(function (a) { return a.q <= target; });
        var scope = root.querySelector('.step[data-step="' + target + '"]');
        if (scope) {
          scope.classList.remove('is-locked');
          Array.prototype.forEach.call(scope.querySelectorAll('.chip'), function (n) {
            n.classList.remove('is-selected');
            n.removeAttribute('aria-busy');
            var label = n.getAttribute('data-label');
            if (label) n.textContent = label;
          });
        }
        goTo(target);
      });
    }

    paintProgress(1);
  })();
</script>

<style>
  .quiz {
    height: 100dvh;
    display: flex;
    flex-direction: column;
    background-color: #FAF6EE;
    color: #2C3E2D;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    overflow: hidden;
  }

  /* ── progress ── */
  .progress {
    flex: none;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem clamp(1.25rem, 4vw, 2.5rem) 0;
  }
  .track {
    flex: 1;
    display: flex;
    gap: 0.4rem;
    max-width: 26rem;
  }
  .seg {
    height: 0.25rem;
    flex: 1;
    border-radius: 999px;
    background-color: #E5E1DA;
    transition: background-color 0.3s ease;
  }
  .seg.done { background-color: #7A9E7E; }
  .back {
    flex: none;
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    color: #6B7B6C;
    cursor: pointer;
  }
  .back:hover { color: #2C3E2D; }

  /* ── stage ── */
  .stage {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem clamp(1.25rem, 4vw, 2.5rem) 1.5rem;
    position: relative;
  }
  .step {
    width: 100%;
    max-width: 38rem;
    margin: 0 auto;
    text-align: center;
  }
  .kicker {
    font-size: clamp(0.72rem, 1.6vw, 0.8rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #7A9E7E;
    margin: 0 0 0.75rem;
  }
  .step h1 {
    font-size: clamp(1.6rem, 5.2vw, 2.4rem);
    line-height: 1.18;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #2C3E2D;
    margin: 0 0 1.5rem;
  }
  .micro {
    font-size: clamp(0.88rem, 1.8vw, 0.97rem);
    color: #6B7B6C;
    margin: -0.9rem 0 1.4rem;
  }

  /* ── chips ── */
  .chips {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    max-width: 30rem;
    margin: 0 auto;
  }
  .chip {
    font: inherit;
    font-size: clamp(0.95rem, 2.2vw, 1.02rem);
    font-weight: 500;
    text-align: center;
    color: #2C3E2D;
    background-color: #FFFEFB;
    border: 1px solid #E5E1DA;
    border-radius: 12px;
    padding: 0.85rem 1.25rem;
    cursor: pointer;
    transition: border-color 0.18s ease, background-color 0.18s ease, transform 0.18s ease;
  }
  .chip:hover {
    border-color: #7A9E7E;
    transform: translateY(-1px);
  }
  .chip:focus-visible {
    outline: 2px solid #7A9E7E;
    outline-offset: 2px;
  }
  .chip.is-selected {
    background-color: #EEF4EF;
    border-color: #7A9E7E;
  }

  /* ── thank you ── */
  .countdown {
    max-width: 22rem;
    height: 0.3rem;
    margin: 0 auto 0.9rem;
    border-radius: 999px;
    background-color: #E5E1DA;
    overflow: hidden;
  }
  .countdown-bar {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 999px;
    background-color: #7A9E7E;
  }
  .meta {
    font-size: 0.88rem;
    color: #6B7B6C;
    margin: 0 0 1.6rem;
  }
  .sub {
    font-size: clamp(0.95rem, 2.2vw, 1.05rem);
    line-height: 1.55;
    color: #6B7B6C;
    max-width: 26rem;
    margin: 0 auto 1.8rem;
  }
  .thankyou h1 { margin-bottom: 1rem; }
  .watch-now {
    display: inline-block;
    font-size: 1rem;
    font-weight: 600;
    color: #5A7E5E;
    text-decoration: none;
    border-bottom: 1px solid #7A9E7E;
    padding-bottom: 1px;
  }
  .watch-now:hover { color: #2C3E2D; }

  /* ── toast ── */
  .toast {
    position: fixed;
    left: 50%;
    bottom: 1.4rem;
    transform: translateX(-50%);
    width: max-content;
    max-width: calc(100vw - 2rem);
    background-color: #2C3E2D;
    color: #FAF6EE;
    font-size: 0.88rem;
    line-height: 1.5;
    padding: 0.85rem 1.25rem;
    border-radius: 12px;
    text-align: center;
    z-index: 10;
  }
  .toast p { margin: 0; }
  .toast-retry {
    font: inherit;
    background: none;
    border: 0;
    padding: 0;
    color: #9ABE9E;
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
  }
  .toast a {
    color: #E8A87C;
    text-decoration: none;
    border-bottom: 1px solid #E8A87C;
  }
  .noscript-note {
    position: fixed;
    inset: auto 0 0 0;
    background-color: #2C3E2D;
    color: #FAF6EE;
    text-align: center;
    font-size: 0.88rem;
    padding: 1rem;
  }
  .noscript-note a { color: #9ABE9E; }
</style>
