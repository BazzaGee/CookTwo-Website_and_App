---
/**
 * The VSL player.
 *
 * Speaker banner (persistent) · 5s countdown · autoplay · pause-only playback
 * (no rewind, no fast-forward) · timed offer reveal that shrinks the frame and
 * surfaces the capture box for the rest of the video.
 *
 * Reveal times come from each video's own timecodes.csv and were confirmed by
 * extracting the frame either side of the boundary:
 *   couples  revealAt 420.57  slide #167  00:07:00,570
 *   solo     revealAt 500.27  slide #189  00:08:20,270
 */
import FunnelLayout from '../../layouts/FunnelLayout.astro';

interface Props {
  slug: string;
  mode: 'couples' | 'solo';
  revealAt: number;
  title: string;
  description: string;
}

const { slug, mode, revealAt, title, description } = Astro.props;

const toolHref = mode === 'solo' ? '/kitchen-tool-solo' : '/kitchen-tool';
const videoLabel = mode === 'solo' ? 'solo' : 'couples';
const buttonLabel = 'Send me my kitchen tool - The Kitchen Calculator';
---

<FunnelLayout title={title} description={description}>
  <main class="watch">
    <div class="stage" id="stage" data-reveal={revealAt} data-mode={mode} data-tool={toolHref}>
      <div class="frame" id="frame">
        <video
          id="vsl"
          playsinline
          preload="auto"
          tabindex="-1"
          disablepictureinpicture
          controlslist="nodownload noremoteplayback noplaybackrate"
          src={`/api/vsl/${slug}`}
        ></video>

        <!-- 1 · speaker banner — always on top -->
        <div class="banner" role="note">
          <span class="spk spk-left">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M4 9.5h3.2L12 5.6v12.8L7.2 14.5H4a.9.9 0 0 1-.9-.9v-3.2a.9.9 0 0 1 .9-.9Z"
                fill="currentColor"></path>
              <path class="ct-wave w1" d="M15.2 9.4a4.2 4.2 0 0 1 0 5.2" stroke="currentColor"
                stroke-width="1.9" stroke-linecap="round"></path>
              <path class="ct-wave w2" d="M18 7.6a7.6 7.6 0 0 1 0 8.8" stroke="currentColor"
                stroke-width="1.9" stroke-linecap="round"></path>
              <path class="ct-wave w3" d="M20.8 5.8a11 11 0 0 1 0 12.4" stroke="currentColor"
                stroke-width="1.9" stroke-linecap="round"></path>
            </svg>
          </span>
          <span class="banner-text">Make sure your speakers are turned on</span>
          <span class="spk spk-right">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M4 9.5h3.2L12 5.6v12.8L7.2 14.5H4a.9.9 0 0 1-.9-.9v-3.2a.9.9 0 0 1 .9-.9Z"
                fill="currentColor"></path>
              <path class="ct-wave w1" d="M15.2 9.4a4.2 4.2 0 0 1 0 5.2" stroke="currentColor"
                stroke-width="1.9" stroke-linecap="round"></path>
              <path class="ct-wave w2" d="M18 7.6a7.6 7.6 0 0 1 0 8.8" stroke="currentColor"
                stroke-width="1.9" stroke-linecap="round"></path>
              <path class="ct-wave w3" d="M20.8 5.8a11 11 0 0 1 0 12.4" stroke="currentColor"
                stroke-width="1.9" stroke-linecap="round"></path>
            </svg>
          </span>
        </div>

        <!-- 2 · 5 second countdown -->
        <div class="countdown" id="countdown" role="status" aria-label="Video starting shortly">
          <div class="cd-ring-wrap">
            <svg class="cd-ring" viewBox="0 0 100 100" aria-hidden="true">
              <circle class="cd-track" cx="50" cy="50" r="44"></circle>
              <circle class="cd-prog" cx="50" cy="50" r="44"></circle>
            </svg>
            <span class="cd-num" id="cd-num">5</span>
          </div>
          <p class="cd-label">Your video starts shortly</p>
        </div>

        <!-- 3 · only appears if the browser refuses to start with sound -->
        <button type="button" class="tapstart" id="tapstart" hidden>
          <span class="tapstart-circle" aria-hidden="true"><span class="tapstart-tri"></span></span>
          <span class="tapstart-label">Tap to start with sound</span>
        </button>

        <!-- 4 · the only control -->
        <button type="button" class="pausebtn" id="pausebtn" hidden aria-label="Pause video">
          <svg class="ic ic-pause" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="6.5" y="5" width="4" height="14" rx="1.4"></rect>
            <rect x="13.5" y="5" width="4" height="14" rx="1.4"></rect>
          </svg>
          <svg class="ic ic-play" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 5.6v12.8l10.4-6.4z"></path>
          </svg>
        </button>
      </div>

      <!-- 5 · the capture box, revealed at revealAt and held for the rest -->
      <div class="offer" id="offer">
        <form class="offer-form" id="offer-form" novalidate>
          <p class="offer-head">Put your address in the box under this video&hellip;</p>
          <div class="offer-row">
            <input
              class="offer-input"
              type="email"
              id="offer-email"
              name="email"
              placeholder="you@example.com"
              autocomplete="email"
              inputmode="email"
              required
            />
            <button class="offer-btn" type="submit" id="offer-btn">{buttonLabel}</button>
          </div>
          <p class="offer-micro">
            Opens in your browser. No install, no account, no card. Yours to keep.
          </p>
          <p class="offer-err" id="offer-err" role="alert" hidden></p>
        </form>

        <div class="offer-done" id="offer-done" hidden>
          <p class="offer-head">Thanks &mdash; your Kitchen Calculator is on its way.</p>
          <p class="offer-sub">
            Check your inbox and click the link to open the tool. It takes about a minute.
          </p>
        </div>
      </div>
    </div>
  </main>
</FunnelLayout>

<script>
  (function () {
    'use strict';

    var stage = document.getElementById('stage');
    var video = document.getElementById('vsl');
    if (!stage || !video) return;

    var revealAt = parseFloat(stage.getAttribute('data-reveal') || '0') || 0;
    var mode = stage.getAttribute('data-mode') || 'couples';

    var countdown = document.getElementById('countdown');
    var cdNum = document.getElementById('cd-num');
    var tap = document.getElementById('tapstart');
    var pauseBtn = document.getElementById('pausebtn');
    var form = document.getElementById('offer-form');
    var emailIn = document.getElementById('offer-email');
    var submitBtn = document.getElementById('offer-btn');
    var errMsg = document.getElementById('offer-err');
    var doneBox = document.getElementById('offer-done');

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var STORE_KEY = 'ct-vsl-tool-' + mode;

    function track(name, params) {
      if (typeof window.gtag === 'function') window.gtag('event', name, params || {});
    }

    function showErr(msg) {
      if (!errMsg) return;
      errMsg.textContent = msg;
      errMsg.hidden = false;
    }

    function showDone() {
      if (form) form.hidden = true;
      if (doneBox) doneBox.hidden = false;
    }

    // ── playback ─────────────────────────────────────────────────────
    video.muted = false;

    function tryPlay(source) {
      var p = video.play();
      if (!p || typeof p.then !== 'function') return;
      p.then(function () {
        if (tap) tap.hidden = true;
        if (source === 'tap') track('vsl_play', { video: mode, method: 'tap' });
      }).catch(function () {
        if (tap) tap.hidden = false;
        track('vsl_autoplay_blocked', { video: mode });
      });
    }

    function togglePause() {
      if (video.paused) tryPlay('tap');
      else video.pause();
    }

    // ── 5 second countdown ───────────────────────────────────────────
    var COUNTDOWN_SECONDS = 5;
    var countdownDone = false;

    function runCountdown() {
      if (cdNum) cdNum.textContent = String(COUNTDOWN_SECONDS);
      // The ring's 5s sweep is tied to this class, not to CSS load, so the
      // animation and the number can never drift apart.
      if (countdown) countdown.classList.add('is-run');
      track('vsl_countdown_start', { video: mode });

      var left = COUNTDOWN_SECONDS;
      var id = window.setInterval(function () {
        left -= 1;
        if (left > 0) {
          if (cdNum) {
            cdNum.textContent = String(left);
            if (!reduced) {
              cdNum.classList.remove('cd-pop');
              void cdNum.offsetWidth;
              cdNum.classList.add('cd-pop');
            }
          }
          return;
        }
        window.clearInterval(id);
        countdownDone = true;
        if (countdown) countdown.classList.add('is-gone');
        tryPlay('auto');
      }, 1000);
    }

    // Many browsers refuse to start with sound until the visitor touches the
    // page. The moment they do, start it — nobody should have to find a button.
    function armGestureKick() {
      function kick() {
        document.removeEventListener('pointerdown', kick);
        document.removeEventListener('keydown', kick);
        if (!countdownDone || !video.paused) return;
        tryPlay('gesture');
        // Real gestures always work; this only re-arms on a genuinely blocked
        // attempt, and it removes itself first so listeners never pile up.
        if (video.paused) armGestureKick();
      }
      document.addEventListener('pointerdown', kick, { passive: true });
      document.addEventListener('keydown', kick);
    }

    // ── pause only: no rewind, no fast-forward ───────────────────────
    var maxTime = 0;

    video.addEventListener('timeupdate', function () {
      if (video.currentTime > maxTime) maxTime = video.currentTime;
      maybeReveal();
    });

    video.addEventListener('seeking', function () {
      // Any jump that is not a tiny forward buffer slip gets pulled back to
      // the furthest point actually watched. No flag needed: once clamped,
      // currentTime === maxTime and the tolerance below swallows the second pass.
      if (video.currentTime < maxTime - 0.05 || video.currentTime > maxTime + 0.6) {
        video.currentTime = maxTime;
      }
    });

    video.addEventListener('ratechange', function () {
      if (video.playbackRate !== 1) video.playbackRate = 1;
      if (video.defaultPlaybackRate !== 1) video.defaultPlaybackRate = 1;
    });

    video.addEventListener('contextmenu', function (e) {
      e.preventDefault();
    });

    document.addEventListener('keydown', function (e) {
      var t = e.target;
      if (t !== video && t !== pauseBtn) return;
      var k = e.key;
      if (
        k === 'ArrowLeft' ||
        k === 'ArrowRight' ||
        k === 'Home' ||
        k === 'End' ||
        k === 'PageUp' ||
        k === 'PageDown'
      ) {
        e.preventDefault();
        return;
      }
      if (k === ' ' || k === 'Spacebar') {
        e.preventDefault();
        togglePause();
      }
    });

    if ('mediaSession' in navigator) {
      try {
        var ms = navigator.mediaSession;
        var noop = function () {};
        ms.setActionHandler('play', function () { tryPlay('system'); });
        ms.setActionHandler('pause', function () { video.pause(); });
        ms.setActionHandler('playpause', togglePause);
        ms.setActionHandler('seekbackward', noop);
        ms.setActionHandler('seekforward', noop);
        ms.setActionHandler('seekto', noop);
        ms.setActionHandler('previoustrack', noop);
        ms.setActionHandler('nexttrack', noop);
        ms.setMetadata({ title: 'CookTwo — the Kitchen Calculator', artist: 'CookTwo' });
      } catch (err) { /* older browsers */ }
    }

    video.addEventListener('playing', function () {
      if (!pauseBtn) return;
      pauseBtn.hidden = false;
      pauseBtn.classList.remove('is-paused');
      pauseBtn.setAttribute('aria-label', 'Pause video');
      track('vsl_play', { video: mode, method: 'auto' });
    });

    video.addEventListener('pause', function () {
      if (!pauseBtn || video.ended) return;
      pauseBtn.hidden = false;
      pauseBtn.classList.add('is-paused');
      pauseBtn.setAttribute('aria-label', 'Resume video');
      track('vsl_pause', { video: mode, at: Math.round(video.currentTime) });
    });

    video.addEventListener('ended', function () {
      if (pauseBtn) pauseBtn.hidden = true;
      track('vsl_complete', { video: mode, duration: Math.round(video.duration || 0) });
    });

    if (pauseBtn) {
      pauseBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        togglePause();
      });
    }

    if (tap) {
      tap.addEventListener('click', function (e) {
        e.stopPropagation();
        tryPlay('tap');
      });
    }

    // ── the timed offer reveal ───────────────────────────────────────
    var revealed = false;

    function maybeReveal() {
      if (revealed) return;
      if (video.currentTime < revealAt) return;
      revealed = true;
      stage.classList.add('is-offer');
      try {
        if (window.sessionStorage.getItem(STORE_KEY)) showDone();
      } catch (err) { /* storage blocked */ }
      track('vsl_offer_shown', { video: mode, at: revealAt });
    }

    video.addEventListener('loadedmetadata', maybeReveal);
    video.addEventListener('canplay', maybeReveal);

    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!submitBtn || submitBtn.disabled) return;

        var email = emailIn ? emailIn.value.trim() : '';
        if (errMsg) errMsg.hidden = true;
        if (emailIn) emailIn.classList.remove('is-bad');

        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          if (emailIn) emailIn.classList.add('is-bad');
          showErr('Please enter a valid email address.');
          return;
        }

        var label = submitBtn.textContent || '';
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending…';
        track('vsl_offer_submit', { video: mode, magnet: 'kitchen-tool' });

        var utm = {};
        try {
          var q = new URLSearchParams(window.location.search);
          ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'via'].forEach(function (k) {
            var v = q.get(k);
            if (v) utm[k] = v;
          });
        } catch (err) { /* no params */ }

        fetch('/api/lead/vsl-tool', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, mode: mode, utm: utm }),
        })
          .then(function (res) {
            return res.json().then(function (data) {
              return { ok: res.ok, data: data };
            });
          })
          .then(function (res) {
            submitBtn.disabled = false;
            submitBtn.textContent = label;
            if (!res.ok) {
              showErr((res.data && res.data.error) || 'Something went wrong — please try again.');
              return;
            }
            try {
              window.sessionStorage.setItem(STORE_KEY, email);
            } catch (err) { /* storage blocked */ }
            showDone();
            track('sign_up', { method: 'email', video: mode, magnet: 'kitchen-tool' });
          })
          .catch(function () {
            submitBtn.disabled = false;
            submitBtn.textContent = label;
            showErr('Network problem — please try again.');
          });
      });
    }

    runCountdown();
    armGestureKick();
    maybeReveal();
  })();
</script>

<style>
  [hidden] {
    display: none !important;
  }

  .watch {
    height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f5f0e6;
    color: #2c3e2d;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    padding: clamp(0.75rem, 3vw, 2.25rem);
    overflow: hidden;
  }

  .stage {
    width: min(100%, 62rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.5rem, 1.6vh, 1rem);
    transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .stage.is-offer {
    width: min(100%, 50rem);
  }

  .frame {
    position: relative;
    container-type: inline-size;
    width: 100%;
    max-width: calc(78dvh * 16 / 9);
    aspect-ratio: 16 / 9;
    margin-inline: auto;
    border-radius: 14px;
    overflow: hidden;
    background-color: #1c271d;
    box-shadow: 0 10px 40px rgba(44, 62, 45, 0.18);
    transition: max-width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .stage.is-offer .frame {
    max-width: calc((100dvh - 17.5rem) * 16 / 9);
  }
  /* Rotated phones and short laptop windows: the offer still has to sit above
     the fold, so the frame gives up more of the height budget and the copy
     tightens rather than the page scrolling. */
  @media (max-height: 560px) {
    .stage.is-offer .frame {
      max-width: calc((100dvh - 12rem) * 16 / 9);
    }
    .offer {
      gap: 0.25rem;
    }
    .offer-head {
      font-size: 0.9rem;
    }
    .offer-sub,
    .offer-micro {
      font-size: 0.72rem;
    }
    .offer-input,
    .offer-btn {
      padding-block: 0.55rem;
    }
  }

  .frame video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    background-color: #1c271d;
  }

  /* ── speaker banner ─────────────────────────────────────────────── */
  .banner {
    position: absolute;
    top: 3cqw;
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 2.6cqw;
    padding: 2.2cqw 4.4cqw;
    border-radius: 999px;
    background-color: rgba(28, 39, 29, 0.74);
    border: 1px solid rgba(250, 246, 238, 0.17);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.22);
    max-width: calc(100% - 5cqw);
    line-height: 1;
  }
  .banner-text {
    color: #faf6ee;
    font-size: clamp(0.48rem, 3.8cqw, 0.86rem);
    font-weight: 600;
    letter-spacing: 0.012em;
    white-space: nowrap;
  }
  .spk {
    display: block;
    flex: none;
    width: clamp(0.7rem, 6.4cqw, 1.15rem);
    height: clamp(0.7rem, 6.4cqw, 1.15rem);
    color: #9abe9e;
  }
  .spk svg {
    display: block;
    width: 100%;
    height: 100%;
    animation: ct-spk 1.5s ease-in-out infinite;
  }
  .spk-left {
    transform: scaleX(-1);
  }
  .ct-wave {
    opacity: 0;
    animation: ct-wave 1.5s ease-out infinite;
  }
  .w2 {
    animation-delay: 0.22s;
  }
  .w3 {
    animation-delay: 0.44s;
  }

  @keyframes ct-spk {
    0%,
    100% {
      transform: scale(1);
    }
    45% {
      transform: scale(1.1);
    }
  }
  @keyframes ct-wave {
    0% {
      opacity: 0;
    }
    22% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  /* ── countdown ──────────────────────────────────────────────────── */
  .countdown {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.7rem, 3cqw, 1.4rem);
    background-color: rgba(28, 39, 29, 0.95);
    transition: opacity 0.35s ease, visibility 0s linear 0.35s;
  }
  .countdown.is-gone {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .cd-ring-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(4.5rem, 30cqw, 9.5rem);
    height: clamp(4.5rem, 30cqw, 9.5rem);
  }
  .cd-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .cd-track {
    fill: none;
    stroke: rgba(250, 246, 238, 0.15);
    stroke-width: 4;
  }
  .cd-prog {
    fill: none;
    stroke: #9abe9e;
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 276.46;
    stroke-dashoffset: 0;
    transform: rotate(-90deg);
    transform-origin: 50% 50%;
  }
  .countdown.is-run .cd-prog {
    animation: ct-ring 5s linear forwards;
  }
  .cd-num {
    position: relative;
    color: #faf6ee;
    font-size: clamp(2rem, 15cqw, 5rem);
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .cd-num.cd-pop {
    animation: ct-pop 0.4s cubic-bezier(0.2, 0.8, 0.3, 1);
  }
  .cd-label {
    margin: 0;
    color: rgba(250, 246, 238, 0.7);
    font-size: clamp(0.6rem, 4.4cqw, 0.85rem);
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  @keyframes ct-ring {
    to {
      stroke-dashoffset: 276.46;
    }
  }
  @keyframes ct-pop {
    0% {
      transform: scale(0.72);
      opacity: 0.4;
    }
    60% {
      transform: scale(1.12);
      opacity: 1;
    }
    100% {
      transform: scale(1);
    }
  }

  /* ── tap to start (only if autoplay is refused) ─────────────────── */
  .tapstart {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.8rem, 5cqw, 1.4rem);
    background-color: rgba(28, 39, 29, 0.58);
    border: 0;
    padding: 0;
    cursor: pointer;
    font-family: inherit;
  }
  .tapstart-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(3rem, 22cqw, 5.2rem);
    height: clamp(3rem, 22cqw, 5.2rem);
    border-radius: 50%;
    background-color: rgba(122, 158, 126, 0.94);
    transition: transform 0.2s ease;
  }
  .tapstart:hover .tapstart-circle,
  .tapstart:focus-visible .tapstart-circle {
    transform: scale(1.06);
  }
  .tapstart-tri {
    width: 0;
    height: 0;
    border-left: clamp(1rem, 7cqw, 1.35rem) solid #faf6ee;
    border-top: clamp(0.6rem, 4.5cqw, 0.9rem) solid transparent;
    border-bottom: clamp(0.6rem, 4.5cqw, 0.9rem) solid transparent;
    margin-left: clamp(0.25rem, 2cqw, 0.4rem);
  }
  .tapstart-label {
    color: #faf6ee;
    font-size: clamp(0.68rem, 4.6cqw, 1.05rem);
    font-weight: 600;
  }

  /* ── pause / resume ─────────────────────────────────────────────── */
  .pausebtn {
    position: absolute;
    right: clamp(0.5rem, 3cqw, 0.9rem);
    bottom: clamp(0.5rem, 3cqw, 0.9rem);
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(2.1rem, 9cqw, 2.7rem);
    height: clamp(2.1rem, 9cqw, 2.7rem);
    padding: 0;
    border-radius: 999px;
    background-color: rgba(28, 39, 29, 0.72);
    border: 1px solid rgba(250, 246, 238, 0.22);
    color: #faf6ee;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.18s ease, background-color 0.18s ease;
  }
  .pausebtn:hover,
  .pausebtn:focus-visible {
    opacity: 1;
    background-color: rgba(122, 158, 126, 0.94);
    outline: none;
  }
