---
interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
  robotsMeta?: string;
  articlePublishedDate?: string;
  articleAuthor?: string;
  articleTags?: string[];
  isArticle?: boolean;
}

const { title, description, canonicalURL, ogImage, robotsMeta, articlePublishedDate, articleAuthor, articleTags = [], isArticle = false } = Astro.props;
const siteURL = 'https://cooktwo.com';
const canonical = canonicalURL ? `${siteURL}${canonicalURL}` : Astro.url;
const ogImg = ogImage || `${siteURL}/images/hero/og-homepage.webp`;
// Cloudflare Web Analytics — set PUBLIC_CF_RUM_TOKEN (real token from the CF
// Pages project settings) to enable the beacon. Skipped while unset so the
// placeholder token doesn't emit /cdn-cgi/rum CORS errors on every page.
const cfRumToken = import.meta.env.PUBLIC_CF_RUM_TOKEN;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "CookTwo",
  "url": "https://cooktwo.com",
  "logo": "https://cooktwo.com/images/logo/logo-icon.png",
  "description": "Collaborative adaptive nutrition app for couples — one meal, two plates.",
  "foundingDate": "2025",
  "founder": {
    "@type": "Person",
    "name": "Barry"
  }
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "CookTwo",
  "url": "https://cooktwo.com",
  "description": "Collaborative adaptive nutrition app for couples."
};

const articleSchema = isArticle && articlePublishedDate ? {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "author": { "@type": "Person", "name": articleAuthor || "CookTwo" },
  "datePublished": articlePublishedDate,
  "image": ogImg.startsWith("http") ? ogImg : `${siteURL}${ogImg}`,
  "publisher": { "@type": "Organization", "name": "CookTwo", "logo": { "@type": "ImageObject", "url": `${siteURL}/images/logo/logo-icon.png` } },
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonical }
} : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="light" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content="couples meal planning, shared grocery list, adaptive cooking, meal planning for couples, pantry AI, CookTwo, collaborative nutrition, two plates" />
<meta name="author" content="CookTwo" />
<meta name="robots" content={robotsMeta ?? "index, follow"} />

<link rel="canonical" href={canonical} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImg} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content="CookTwo" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImg} />

<link rel="manifest" href="/manifest.json" />
<meta name="theme-color" content="#7A9E7E" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<meta name="apple-mobile-web-app-title" content="CookTwo" />

<meta name="googlebot" content="index, follow" />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/images/logo/logo-icon.png" />

<!-- Cloudflare Web Analytics — rendered only when PUBLIC_CF_RUM_TOKEN is set -->
{cfRumToken && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cfRumToken })}></script>}

<!-- Google Analytics (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-VVZFC3RYZ7"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  // Internal traffic: visit any page with ?internal=1 once to set a 90-day
  // cookie. While set, events carry traffic_type=internal so the GA4
  // internal-traffic data filter excludes this browser.
  (function () {
    var internal =
      new URLSearchParams(window.location.search).get('internal') === '1' ||
      document.cookie.indexOf('ga_internal=1') !== -1;
    if (internal) {
      document.cookie = 'ga_internal=1; path=/; max-age=7776000; SameSite=Lax';
      gtag('config', 'G-VVZFC3RYZ7', { traffic_type: 'internal' });
    } else {
      gtag('config', 'G-VVZFC3RYZ7');
    }
  })();
</script>

<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
{articleSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
)}
