---
interface SpectrumChip {
  label: string;
  href: string;
  row: 1 | 2 | 3 | 4;
  col: 1 | 2 | 3 | 4;
  grade: string;
}

interface Props {
  chips: SpectrumChip[];
  figLabel?: string;
  caption?: string;
}

const { chips, figLabel, caption } = Astro.props;

const colLabels = ['Under 10% carb', '10–35% carb', '35–60% carb', 'Over 60% carb'];
const rowLabels = ['Under 10% fat', '10–30% fat', '30–45% fat', 'Over 45% fat'];
const gradeCls: Record<string, string> = {
  A: 'border-sage-dark',
  B: 'border-sage',
  C: 'border-terracotta-dark',
  D: 'border-error'
};
const gradeDot: Record<string, string> = {
  A: 'bg-sage-dark',
  B: 'bg-sage',
  C: 'bg-terracotta-dark',
  D: 'bg-error'
};
---

<figure class="not-prose my-8 rounded-2xl border border-border bg-white shadow-sm overflow-hidden">
  <figcaption class="px-5 sm:px-7 py-4 bg-cream-dark border-b border-border">
    <span class="block text-base font-bold text-text-primary">The healthy-diet map: one axis does not decide your health</span>
    <span class="block text-sm text-text-secondary mt-0.5">Every cell in this map contains a pattern ordinary people follow — and the cell tells you almost nothing on its own. Colours show evidence strength.</span>
  </figcaption>
  <div class="overflow-x-auto">
    <div class="min-w-[720px] p-5 sm:p-6">
      <div class="grid grid-cols-[auto_repeat(4,1fr)] gap-1.5 items-stretch">
        <div class="w-24"></div>
        {colLabels.map((c) => (
          <div class="text-center text-[11px] font-semibold uppercase tracking-wide text-text-secondary pb-1 px-1">{c}</div>
        ))}

        {[4, 3, 2, 1].map((row) => (
          <Fragment>
            <div class="w-24 flex items-center text-[11px] font-semibold uppercase tracking-wide text-text-secondary pr-1">{rowLabels[row - 1]}</div>
            {[1, 2, 3, 4].map((col) => (
              <div class="rounded-xl border border-dashed border-border/70 bg-cream/50 p-2 flex flex-col gap-2 min-h-[76px]">
                {chips.filter((c) => c.row === row && c.col === col).map((c) => (
                  <a href={c.href} class:list={['group flex items-center gap-2 rounded-lg border-2 bg-white px-2.5 py-1.5 text-xs font-medium text-text-primary hover:shadow-sm transition-shadow', gradeCls[c.grade[0]]]} title={`Evidence grade ${c.grade}`}>
                    <span class:list={[gradeDot[c.grade[0]], 'w-2 h-2 rounded-full flex-shrink-0']} aria-hidden="true"></span>
                    <span class="truncate group-hover:text-sage-dark">{c.label}</span>
                  </a>
                ))}
              </div>
            ))}
          </Fragment>
        ))}
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-text-secondary">
        <span class="font-semibold text-text-primary">Evidence grade:</span>
        <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-sage-dark"></span>A — strong</span>
        <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-sage"></span>B — moderate</span>
        <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-terracotta-dark"></span>C — limited</span>
        <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-error"></span>D — insufficient</span>
      </div>
      <div class="mt-3 rounded-xl bg-cream-dark border border-border px-4 py-3 text-xs text-text-secondary">
        <span class="inline-flex items-center gap-2 rounded-lg bg-white border border-sage px-2.5 py-1 text-[11px] font-medium text-text-primary mr-2">⏰ Intermittent fasting</span>
        is a schedule, not a macro position — the food eaten inside the window can be anything above. Asterisked condition patterns (gluten-free, low-sodium, diabetes-friendly, bone-health) adapt the shape of whichever base diet you choose. Placements are approximate typical intakes; individual versions vary.
      </div>
    </div>
  </div>
  {caption && (
    <p class="border-t border-border bg-cream-dark px-5 py-4 sm:px-7 text-sm leading-relaxed text-text-secondary">
      {figLabel && <strong class="font-semibold text-text-primary">{figLabel}</strong>} {caption}
    </p>
  )}
</figure>
