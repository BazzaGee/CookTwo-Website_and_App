---
import type { DietEntry } from '../data/diets';

interface Props {
  diet: DietEntry;
  href: string;
  hubSummary?: string;
}

const { diet, href, hubSummary } = Astro.props;
---

<a href={href} class="group not-prose flex flex-col rounded-2xl border border-border bg-white p-5 sm:p-6 shadow-sm hover:border-sage hover:shadow-md transition-all h-full">
  <div class="flex items-start justify-between gap-3 mb-2">
    <span class="text-3xl leading-none" aria-hidden="true">{diet.emoji}</span>
    <span class:list={['inline-flex items-center justify-center w-7 h-7 rounded-full font-bold text-xs text-white', { A: 'bg-sage-dark', B: 'bg-sage', C: 'bg-terracotta-dark', D: 'bg-error' }[diet.evidenceGrade[0]] ?? 'bg-error']} title={`Evidence grade ${diet.evidenceGrade}`}>{diet.evidenceGrade.toUpperCase()}</span>
  </div>
  <h3 class="font-bold text-text-primary group-hover:text-sage transition-colors leading-snug">{diet.displayLabel}</h3>
  <p class="mt-1.5 text-sm text-text-secondary leading-relaxed flex-grow">{hubSummary ?? diet.shortDesc}</p>
  {diet.macroSplit ? (
    <p class="mt-3 text-xs font-medium text-text-secondary">{diet.macroSplit.carb}% C · {diet.macroSplit.protein}% P · {diet.macroSplit.fat}% F</p>
  ) : (
    <p class="mt-3 text-xs font-medium text-terracotta-dark">{diet.isTimingPattern ? 'Timing pattern' : 'Variable macros'}</p>
  )}
  <span class="mt-3 text-sm font-semibold text-sage-dark group-hover:text-sage transition-colors">Read the evidence →</span>
</a>
