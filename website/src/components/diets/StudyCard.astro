---
interface Props {
  name: string;
  design: string;
  participants: string;
  duration: string;
  finding: string;
  url?: string;
  note?: string;
}

const { name, design, participants, duration, finding, url, note } = Astro.props;

// **double asterisks** mark bold emphasis inside a finding; all other text stays plain
const findingParts = finding
  .split(/(\*\*[^*]+\*\*)/)
  .filter(Boolean)
  .map((part) =>
    part.startsWith('**') && part.endsWith('**')
      ? { text: part.slice(2, -2), strong: true }
      : { text: part, strong: false }
  );
---

<div class="not-prose my-6 rounded-2xl border border-border bg-white p-6 sm:p-7 shadow-sm">
  <p class="text-[11px] font-semibold uppercase tracking-widest text-terracotta-dark mb-1.5">Landmark study</p>
  <h3 class="text-lg font-bold text-text-primary leading-snug">{name}</h3>
  <p class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs text-text-secondary">
    <span class="inline-flex items-center gap-1"><svg class="w-3.5 h-3.5 text-sage-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M7 12h10M7 8h10M7 16h6"/></svg>{design}</span>
    <span aria-hidden="true">·</span>
    <span>{participants}</span>
    <span aria-hidden="true">·</span>
    <span>{duration}</span>
  </p>
  <p class="mt-3 text-text-primary leading-relaxed">{findingParts.map((part) => (part.strong ? <strong class="font-semibold">{part.text}</strong> : part.text))}</p>
  {note && <p class="mt-2 text-sm text-text-secondary">{note}</p>}
  {url && <a href={url} class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-sage-dark hover:text-sage transition-colors" target="_blank" rel="noopener noreferrer">Read the study <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg></a>}
</div>
