---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import QuickFacts from '../components/diets/QuickFacts.astro';
import DietToc from '../components/diets/DietToc.astro';
import BackToHub from '../components/diets/BackToHub.astro';
import MedicalDisclaimer from '../components/diets/MedicalDisclaimer.astro';
import { DIET_CATEGORY_ORDER } from '../data/diet-guides';

interface Props {
  entry: CollectionEntry<'diets'>;
  headings: { depth: number; slug: string; text: string }[];
}

const { entry, headings } = Astro.props;
const d = entry.data;
const category = DIET_CATEGORY_ORDER.find((c) => c.id === d.category);
const formattedDate = d.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const formattedUpdated = d.updatedDate?.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const canonical = `/diets/${entry.id}`;
const siteURL = 'https://cooktwo.com';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteURL}/` },
    { '@type': 'ListItem', position: 2, name: 'Diet evidence', item: `${siteURL}/diets/` },
    { '@type': 'ListItem', position: 3, name: d.title.replace(/ \| CookTwo$/, ''), item: `${siteURL}${canonical}/` }
  ]
};

const medicalSchema = d.medical
  ? {
      '@context': 'https://schema.org',
      '@type': 'MedicalWebPage',
      name: d.title.replace(/ \| CookTwo$/, ''),
      description: d.description,
      url: `${siteURL}${canonical}/`,
      lastReviewed: (d.updatedDate ?? d.pubDate).toISOString(),
      reviewedBy: { '@type': 'Organization', name: 'CookTwo Research' },
      about: { '@type': 'MedicalWebPage' },
      speciality: 'https://schema.org/Nutrition'
    }
  : null;
---

<BaseLayout
  title={`${d.title.replace(/ \| CookTwo$/, '')} | CookTwo`}
  description={d.description}
  ogImage={d.ogImage}
  canonicalURL={canonical}
  isArticle={true}
  articlePublishedDate={d.pubDate.toISOString()}
  articleAuthor={d.author}
  articleTags={d.tags}
>
  {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>}
  {medicalSchema && <script type="application/ld+json" set:html={JSON.stringify(medicalSchema)}></script>}

  <a href="/diets" class="inline-block text-sm font-medium text-sage hover:text-sage-dark mt-10 transition-colors container-custom max-w-6xl">← All diet evidence guides</a>

  <article class="container-custom max-w-6xl py-8 md:py-12">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_290px] gap-10 xl:gap-14">
      <div class="min-w-0">
        <header class="mb-10">
          <div class="flex flex-wrap items-center gap-2.5 mb-4">
            {category && <span class="text-xs px-3 py-1 rounded-full bg-sage/10 text-sage-dark border border-sage/30 font-semibold">{category.label}</span>}
            {d.medical && <span class="text-xs px-3 py-1 rounded-full bg-cream-dark text-text-secondary border border-border font-medium">Clinical context</span>}
            {d.readingTime && <span class="text-xs text-text-secondary">{d.readingTime} read</span>}
          </div>

          <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-text-primary leading-tight mb-5">{d.title.replace(/ \| CookTwo$/, '')}</h1>
          <p class="text-lg md:text-xl text-text-secondary leading-relaxed mb-6 max-w-3xl">{d.description}</p>

          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-text-secondary">
            <span>{d.author}</span>
            <span aria-hidden="true">·</span>
            <time datetime={d.pubDate.toISOString()}>{formattedDate}</time>
            {d.updatedDate && formattedUpdated && d.updatedDate.toISOString() !== d.pubDate.toISOString() && (
              <>
                <span aria-hidden="true">·</span>
                <span>Updated {formattedUpdated}</span>
              </>
            )}
          </div>
        </header>

        <div class="lg:hidden mb-10">
          <QuickFacts grade={d.evidenceGrade} macroSplit={d.macroSplit} isTimingPattern={d.isTimingPattern} restrictiveness={d.restrictiveness} bestFor={d.bestFor} hardestPart={d.hardestPart} medicalCaution={d.medicalCaution} />
          <div class="mt-6 overflow-x-auto">
            <DietToc items={headings} />
          </div>
        </div>

        <div class="prose prose-xl max-w-none
          prose-headings:tracking-tight prose-headings:text-text-primary
          prose-h2:text-3xl prose-h2:mt-14 prose-h2:mb-6 prose-h2:scroll-mt-24
          prose-h3:text-2xl prose-h3:mt-10 prose-h3:mb-4 prose-h3:scroll-mt-24
          prose-p:text-text-primary prose-p:leading-relaxed
          prose-a:text-sage-dark prose-a:no-underline hover:prose-a:underline
          prose-strong:text-text-primary
          prose-li:text-text-primary
          prose-img:rounded-2xl prose-img:shadow-sm
          prose-blockquote:border-sage prose-blockquote:text-text-secondary
          prose-figure:my-0 prose-figcaption:text-sm
        ">
          <slot />
        </div>

        <BackToHub />
        <MedicalDisclaimer />
      </div>

      <aside class="hidden lg:block">
        <QuickFacts grade={d.evidenceGrade} macroSplit={d.macroSplit} isTimingPattern={d.isTimingPattern} restrictiveness={d.restrictiveness} bestFor={d.bestFor} hardestPart={d.hardestPart} medicalCaution={d.medicalCaution} />
        <div class="mt-6">
          <DietToc items={headings} />
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
