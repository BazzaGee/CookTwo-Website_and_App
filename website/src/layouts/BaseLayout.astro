---
import BaseHead from '../components/layout/BaseHead.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ByteDigitalBadge from '../components/ByteDigitalBadge.astro';
import ChatWidget from '../components/ChatWidget.astro';
import EarlyAccessModal from '../components/forms/EarlyAccessModal.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
  articlePublishedDate?: string;
  articleAuthor?: string;
  articleTags?: string[];
  isArticle?: boolean;
  minimal?: boolean;
  chatEndpoint?: string;
  chatTitle?: string;
  chatSubtitle?: string;
  chatShowLogo?: boolean;
  chatWelcome?: string;
  chatPlaceholder?: string;
  chatSource?: string;
}

const {
  title, description, canonicalURL, ogImage, articlePublishedDate, articleAuthor,
  articleTags, isArticle, minimal = false,
  chatEndpoint, chatTitle, chatSubtitle, chatShowLogo, chatWelcome,
  chatPlaceholder, chatSource,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} canonicalURL={canonicalURL} ogImage={ogImage} articlePublishedDate={articlePublishedDate} articleAuthor={articleAuthor} articleTags={articleTags} isArticle={isArticle} />
  </head>
  <body class={`min-h-screen flex flex-col ${minimal ? '' : 'pt-20'}`}>
    {!minimal && <Header />}
    <main class="flex-grow">
      <slot />
    </main>
    {!minimal && <Footer />}
    {!minimal && <ByteDigitalBadge />}
    <EarlyAccessModal />
    <slot name="after-footer" />
    <ChatWidget
      position={minimal ? 'top' : 'bottom'}
      endpoint={chatEndpoint}
      title={chatTitle}
      subtitle={chatSubtitle}
      showLogo={chatShowLogo}
      welcomeMessage={chatWelcome}
      placeholder={chatPlaceholder}
      source={chatSource}
    />
  </body>
</html>
